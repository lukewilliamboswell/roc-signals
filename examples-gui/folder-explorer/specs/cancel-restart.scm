(test "Canceled scans preserve previous content and reject late results"
  (steps
    (click (role button :name "README.md"))
    (click (role button :name "Choose folder"))
    (resolve-task "folder-choice" "6:files16:chosen12:/tmp/project")
    (expect-pending-task "folder-scan" 1)
    (click (role button :name "Cancel"))
    (expect-pending-task "folder-scan" 0)
    (expect-canceled-task "folder-scan" 1)
    (expect-visible (text "Canceled"))
    (expect-visible (text "Sample workspace"))
    (expect-visible (text "Size: 1536 B"))
    (resolve-stale-task "folder-scan" "not decoded after cancellation")
    (expect-visible (text "Sample workspace"))
    (click (role button :name "Choose folder"))
    (resolve-task "folder-choice" "6:files16:chosen12:/tmp/project")
    (resolve-task "folder-scan" "6:files112:/tmp/project1:417:/tmp/project/docs9:directory4:409622:/tmp/project/notes.txt4:file2:1220:/tmp/project/current13:symbolic-link1:924:/tmp/project/events.pipe5:other1:0")
    (expect-visible (text "Folder: /tmp/project"))
    (expect-visible (text "4 matching entries"))
  ))
