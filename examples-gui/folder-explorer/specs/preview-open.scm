(test "Preview and associated launch report typed results without losing content"
  (steps
    (stub-file-choice "folder-choice" (chosen "/tmp/project"))
    (stub-file-directory "folder-list" :path "/tmp/project" :entries ((file "/tmp/project/note.txt" 70000) (symbolic-link "/tmp/project/link" 4)))
    (click (role button :name "Choose folder"))
    (click (role button :name "/tmp/project/note.txt"))
    (stub-file-read "file-preview" :path "/tmp/project/note.txt" :text "First line\nλ" :size 70000)
    (click (role button :name "Preview text"))
    (expect-value (label "Text preview") "First line\nλ")
    (expect-visible (text "Preview: /tmp/project/note.txt · truncated"))
    (stub-file-reject "file-preview" :kind invalid-utf8 :detail "/tmp/project/note.txt")
    (click (role button :name "Preview text"))
    (expect-visible (text "Not valid UTF-8: /tmp/project/note.txt"))
    (expect-value (label "Text preview") "First line\nλ")
    (stub-file-reject "file-open" :kind unavailable :detail "No associated application")
    (click (role button :name "Open in app"))
    (expect-visible (text "Native service unavailable: No associated application"))
    (expect-value (label "Text preview") "First line\nλ")
    (stub-file-open "file-open" :path "/tmp/project/note.txt")
    (click (role button :name "Retry"))
    (expect-visible (text "Opened /tmp/project/note.txt in its associated application."))
    (click (role button :name "/tmp/project/link"))
    (expect-disabled (role button :name "Preview text") true)
    (expect-disabled (role button :name "Open in app") true)
    (expect-visible (text "Symbolic links are shown but are not followed."))
  ))
