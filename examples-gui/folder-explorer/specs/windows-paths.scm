(test "Windows breadcrumbs name the drive root and every real parent folder"
  (steps
    (stub-file-choice "folder-choice" (chosen "C:\\Users\\Lee"))
    (stub-file-directory "folder-list" :path "C:\\Users\\Lee"
      :entries ((directory "C:\\Users\\Lee\\Notes" 0) (file "C:\\Users\\Lee\\Ideas.txt" 5)))
    (click (role button :name "Choose folder"))
    (expect-visible (label "Go to C:\\"))
    (expect-visible (label "Go to C:\\Users"))
    (expect-visible (label "Go to C:\\Users\\Lee"))
    (expect-text (test-id "dataset-source") "Folder: C:\\Users\\Lee")
    (expect-visible (text "Ideas.txt"))
    (expect-visible (text "Notes"))
    (stub-file-directory "folder-list" :path "C:\\Users\\Lee\\Notes" :entries ())
    (click (role button :name "C:\\Users\\Lee\\Notes"))
    (expect-text (test-id "dataset-source") "Folder: C:\\Users\\Lee\\Notes")
    (stub-file-directory "folder-list" :path "C:\\Users\\Lee" :entries ())
    (click (role button :name "Up"))
    (expect-text (test-id "dataset-source") "Folder: C:\\Users\\Lee")
    (stub-file-directory "folder-list" :path "C:\\Users" :entries ((directory "C:\\Users\\Lee" 0)))
    (click (label "Go to C:\\Users"))
    (expect-text (test-id "dataset-source") "Folder: C:\\Users")
    (expect-visible (role button :name "C:\\Users\\Lee"))
    (expect-visible (text "Lee"))
  ))
