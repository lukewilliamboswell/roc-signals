# size: 1200x820
# Selection, focus and per-row editor identity. Keyed rows is the example that
# teaches row identity, so the presentation layer has to agree with it: the
# selected row is the one the person clicked, and each row's draft belongs to
# that row's own editor.
expect-count row- 3
expect-selected #row-Alpha
click "Select Beta"
wait 200
expect-selected #row-Beta
expect-unselected #row-Alpha
snapshot beta-selected
type "Draft Beta" hello
wait 250
expect-value "Draft Beta" hello
expect-value "Draft Alpha"
expect-focused "Draft Beta"
click "Move first to end"
wait 250
expect-count row- 3
expect-value "Draft Beta" hello
snapshot after-move
click "Hide / show rows"
wait 250
expect-count row- 0
click "Hide / show rows"
wait 250
expect-count row- 3
