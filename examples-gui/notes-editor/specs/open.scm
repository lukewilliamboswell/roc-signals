(test "Opening confirms dirty text then installs one complete Unicode file"
  (steps
    (fill (label "Note text") "Keep this draft")
    (shortcut (test-id "notes-editor") "o" 1)
    (expect-visible (test-id "discard-confirmation"))
    (expect-pending-task "notes-open" 0)
    (click (role button :name "Keep editing"))
    (expect-value (label "Note text") "Keep this draft")
    (shortcut (test-id "notes-editor") "o" 1)
    (click (role button :name "Discard changes"))
    (expect-text (test-id "note-status") "Choose a document…")
    (resolve-file-choice "notes-open" (canceled))
    (expect-value (label "Note text") "Keep this draft")
    (expect-text (test-id "note-status") "Unsaved changes")
    (shortcut (test-id "notes-editor") "o" 1)
    (click (role button :name "Discard changes"))
    (resolve-file-choice "notes-open" (chosen "/tmp/Ideas café.txt"))
    (expect-text (test-id "note-status") "Opening document…")
    (expect-disabled (label "Note text") true)
    (resolve-file-read "notes-read" :path "/tmp/Ideas café.txt" :text "Heading\n\ncafé 🙂\n")
    (expect-text (test-id "document-name") "Ideas café.txt")
    (expect-value (label "Note text") "Heading\n\ncafé 🙂\n")
    (expect-text (test-id "note-status") "No changes")
    (expect-text (test-id "note-summary") "2 words · 16 characters")
    (expect-disabled (label "Note text") false)
    (shortcut (test-id "notes-editor") "n" 1)
    (expect-value (label "Note text") "")
    (expect-text (test-id "document-name") "Untitled note")
    (expect-text (test-id "note-status") "No changes")
))
