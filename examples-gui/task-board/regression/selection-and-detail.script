# size: 1200x820
# Initial, populated, selected, focused and disabled/enabled states. Selecting
# another card must move the selection and re-point the detail editors at the
# task that is now selected.
expect-count task- 8
expect-selected #task-1
expect-disabled Undo
expect-disabled "Add task"
snapshot initial
click #edit-task-4
wait 400
expect-selected #task-4
expect-unselected #task-1
expect-value "Task title" Polish the project sidebar
expect-text In progress
snapshot task-4-selected
focus "Task title"
key end
type "Task title" !
wait 400
expect-focused "Task title"
expect-value "Task title" Polish the project sidebar!
expect-enabled Undo
snapshot edited
type "New task title" Ship it
wait 600
expect-enabled "Add task"
