(test "Save validates retained drafts without discarding invalid text"
 (steps
  (fill (label "Task title") "")
  (expect-value (label "Task title") "")
  (click (role button :name "Save"))
  (expect-pending-task "board-save-path" 0)
  (expect-text (test-id "board-problem") "Cannot save: Task limits are 512 bytes for titles, 8192 for notes, and 128 for assignees. Your draft is retained.")
  (expect-value (label "Task title") "")
  (fill (label "Task title") "A valid task")
  (click (role button :name "Save"))
  (expect-pending-task "board-save-path" 1)
 ))
