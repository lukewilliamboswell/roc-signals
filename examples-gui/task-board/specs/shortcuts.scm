(test "Document and board keyboard shortcuts use the same commands as controls"
 (steps
  (fill (label "Task title") "Shortcut edit")
  (shortcut (test-id "launch-board") "z" 1)
  (expect-value (label "Task title") "Sketch the welcome screen")
  (shortcut (test-id "launch-board") "z" 3)
  (expect-value (label "Task title") "Shortcut edit")
  (shortcut (test-id "launch-board") "s" 1)
  (expect-pending-task "board-save-path" 1)
  (resolve-file-choice "board-save-path" (chosen "/tmp/shortcuts.board.json"))
  (resolve-file-write "board-write" :path "/tmp/shortcuts.board.json" :bytes 1)
  (shortcut (test-id "launch-board") "s" 3)
  (expect-pending-task "board-save-path" 1)
  (resolve-file-choice "board-save-path" (canceled))
  (shortcut (test-id "launch-board") "o" 1)
  (expect-pending-task "board-open" 1)
  (resolve-file-choice "board-open" (canceled))
  (expect-value (label "Task title") "Shortcut edit")
 ))
