main : () -> Elem
main = ||
	Ui.state(
		"row-000",
		|selected| {
			selected_signal = selected.signal()
			render_row = |key, _item| {
				is_selected = Signal.select(selected_signal, key)
				Html.section(
					"Selector row ${key}",
					[Html.test_id(key)],
					[
						Html.checkbox("Selected ${key}", is_selected, selected.on_bool(|current, _| current)),
						Html.button("Select ${key}", selected.on_unit(|_| key)),
					],
				)
			}
			Ui.state(
				True,
				|show_all| {
					items = show_all.signal().map(|visible| if visible rows else ["row-000"])
					Html.div(
						[],
						[
							Html.heading("Signal select 128"),
							Html.button("Show one row", show_all.on_unit(|_| False)),
							Html.button("Show all rows", show_all.on_unit(|_| True)),
							Ui.each(items, |key| key, |each_row| render_row(each_row.key(), each_row.signal())),
						],
					)
				},
			)
		},
	)
