(test "Conduit — the article page row keeps the newest A after visiting B"
  (setup
    (initial-location "/roc-signals/examples/conduit/#/article/a")
  )
  (steps
    (expect-pending-effects 2)
    (navigate "/roc-signals/examples/conduit/#/article/b")
    (expect-pending-effects 4)
    (navigate "/roc-signals/examples/conduit/#/article/a")
    (expect-pending-effects 6)
    (stub-http "new a" :url "/api/articles/a" :status 200 :body "{\"article\":{\"slug\":\"a\",\"title\":\"New article A\",\"description\":\"Current request coverage.\",\"body\":\"fresh article body\",\"tagList\":[],\"createdAt\":\"2026-06-01T08:00:00.000Z\",\"favorited\":false,\"favoritesCount\":2,\"author\":{\"username\":\"anna\",\"bio\":\"Author.\",\"image\":\"\",\"following\":false}}}")
    (run-effect 5)
    (stub-http "new comments a" :url "/api/articles/a/comments" :status 200 :body "{\"comments\":[]}")
    (run-effect 6)
    (expect-visible (text "New article A"))
    (mark-metrics)
    (stub-http "old a" :url "/api/articles/a" :status 200 :body "{\"article\":{\"slug\":\"a\",\"title\":\"Old article A\",\"description\":\"Current request coverage.\",\"body\":\"fresh article body\",\"tagList\":[],\"createdAt\":\"2026-06-01T08:00:00.000Z\",\"favorited\":false,\"favoritesCount\":2,\"author\":{\"username\":\"anna\",\"bio\":\"Author.\",\"image\":\"\",\"following\":false}}}")
    (run-effect 1)
    (stub-http "old comments a" :url "/api/articles/a/comments" :status 200 :body "{\"comments\":[]}")
    (run-effect 2)
    (stub-http "old b" :url "/api/articles/b" :status 200 :body "{\"article\":{\"slug\":\"b\",\"title\":\"Wrong article B\",\"description\":\"Current request coverage.\",\"body\":\"fresh article body\",\"tagList\":[],\"createdAt\":\"2026-06-01T08:00:00.000Z\",\"favorited\":false,\"favoritesCount\":2,\"author\":{\"username\":\"anna\",\"bio\":\"Author.\",\"image\":\"\",\"following\":false}}}")
    (run-effect 3)
    (stub-http "old comments b" :url "/api/articles/b/comments" :status 200 :body "{\"comments\":[]}")
    (run-effect 4)
    (expect-visible (text "New article A"))
    (expect-visible (text "fresh article body"))
    (expect-current-location "/roc-signals/examples/conduit/#/article/a")
    (expect-pending-effects 0)
    (expect-metric-delta effects_delivered 4)
    (expect-metric-delta effects_cancelled 0)
    (expect-metric-delta patches_emitted 0)
  ))
