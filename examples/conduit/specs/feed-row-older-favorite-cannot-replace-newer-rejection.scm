(test "Conduit — a row mutation keeps the latest rejection after an older success"
  (setup
    (local-storage "conduit.jwt" "jwt.conduit.kim")
    (local-storage "conduit.username" "kim")
    (initial-location "/roc-signals/examples/conduit/#/")
  )
  (steps
    (stub-http "tags" :url "/api/tags" :status 200 :body "{\"tags\":[]}")
    (run-effect 2)
    (stub-http "feed" :url "/api/articles?limit=20&offset=0" :status 200 :body "{\"articles\":[{\"slug\":\"row\",\"title\":\"Row article\",\"description\":\"Current request coverage.\",\"body\":\"fresh article body\",\"tagList\":[],\"createdAt\":\"2026-06-01T08:00:00.000Z\",\"favorited\":false,\"favoritesCount\":2,\"author\":{\"username\":\"anna\",\"bio\":\"Author.\",\"image\":\"\",\"following\":false}}],\"articlesCount\":1}")
    (run-effect 1)
    (click (role button :name "Favorite Row article (2)"))
    (click (role button :name "Favorite Row article (2)"))
    (expect-pending-effects 2)
    (stub-http "latest favorite rejection" :url "/api/articles/row/favorite" :status 422 :body "{\"errors\":{\"body\":[\"rejected\"]}}")
    (run-effect 4)
    (expect-visible (text "The server responded with status 422."))
    (mark-metrics)
    (stub-http "old favorite success" :url "/api/articles/row/favorite" :status 200 :body "{\"article\":{\"slug\":\"row\",\"title\":\"Row article\",\"description\":\"Current request coverage.\",\"body\":\"fresh article body\",\"tagList\":[],\"createdAt\":\"2026-06-01T08:00:00.000Z\",\"favorited\":true,\"favoritesCount\":3,\"author\":{\"username\":\"anna\",\"bio\":\"Author.\",\"image\":\"\",\"following\":false}}}")
    (run-effect 3)
    (expect-visible (role button :name "Favorite Row article (2)"))
    (expect-visible (text "The server responded with status 422."))
    (expect-pending-effects 0)
    (expect-metric-delta effects_delivered 1)
    (expect-metric-delta effects_cancelled 0)
    (expect-metric-delta patches_emitted 0)
  ))
