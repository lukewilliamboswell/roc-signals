(test "Conduit — returning to the same profile still rejects its oldest answer"
  (setup
    (initial-location "/roc-signals/examples/conduit/#/profile/anna")
  )
  (steps
    (expect-pending-effects 2)
    (navigate "/roc-signals/examples/conduit/#/profile/max")
    (expect-pending-effects 4)
    (navigate "/roc-signals/examples/conduit/#/profile/anna")
    (expect-pending-effects 6)
    (stub-http "latest anna" :url "/api/profiles/anna" :status 200 :body "{\"profile\":{\"username\":\"anna\",\"bio\":\"Fresh profile\",\"image\":\"\",\"following\":false}}")
    (run-effect 5)
    (stub-http "latest author articles" :url "/api/articles?limit=20&offset=0&author=anna" :status 200 :body "{\"articles\":[],\"articlesCount\":0}")
    (run-effect 6)
    (expect-visible (text "Fresh profile"))
    (expect-visible (text "No articles are here... yet."))
    (mark-metrics)
    (stub-http "old anna" :url "/api/profiles/anna" :status 200 :body "{\"profile\":{\"username\":\"anna\",\"bio\":\"Old profile\",\"image\":\"\",\"following\":false}}")
    (run-effect 1)
    (stub-http "old anna articles" :url "/api/articles?limit=20&offset=0&author=anna" :status 200 :body "{\"articles\":[],\"articlesCount\":0}")
    (run-effect 2)
    (stub-http "old max" :url "/api/profiles/max" :status 200 :body "{\"profile\":{\"username\":\"max\",\"bio\":\"Wrong profile\",\"image\":\"\",\"following\":false}}")
    (run-effect 3)
    (stub-http "old max articles" :url "/api/articles?limit=20&offset=0&author=max" :status 200 :body "{\"articles\":[],\"articlesCount\":0}")
    (run-effect 4)
    (expect-visible (text "Fresh profile"))
    (expect-visible (text "No articles are here... yet."))
    (expect-current-location "/roc-signals/examples/conduit/#/profile/anna")
    (expect-pending-effects 0)
    (expect-metric-delta effects_delivered 4)
    (expect-metric-delta effects_cancelled 0)
    (expect-metric-delta patches_emitted 0)
  ))
