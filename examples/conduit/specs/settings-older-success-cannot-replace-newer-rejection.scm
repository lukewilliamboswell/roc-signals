(test "Conduit — a settings mutation accepts only its latest submission"
  (setup
    (local-storage "conduit.jwt" "jwt.conduit.kim")
    (local-storage "conduit.username" "kim")
    (initial-location "/roc-signals/examples/conduit/#/settings")
  )
  (steps
    (fill (label "Email") "first@conduit.test")
    (click (role button :name "Update Settings"))
    (fill (label "Email") "second@conduit.test")
    (click (role button :name "Update Settings"))
    (expect-pending-effects 2)
    (stub-http "new settings rejection" :url "/api/user" :status 422 :body "{\"errors\":{\"email\":[\"is invalid\"]}}")
    (run-effect 2)
    (expect-visible (text "email is invalid"))
    (mark-metrics)
    (stub-http "old settings success" :url "/api/user" :status 200 :body "{\"user\":{\"email\":\"first@conduit.test\",\"token\":\"old-token\",\"username\":\"kim\",\"bio\":\"\",\"image\":\"\"}}")
    (run-effect 1)
    (expect-visible (text "email is invalid"))
    (expect-value (label "Email") "second@conduit.test")
    (expect-local-storage "conduit.jwt" "jwt.conduit.kim")
    (expect-current-location "/roc-signals/examples/conduit/#/settings")
    (expect-pending-effects 0)
    (expect-metric-delta effects_delivered 1)
    (expect-metric-delta effects_cancelled 0)
    (expect-metric-delta patches_emitted 0)
  ))
