(test "CSV Converter — fetching the sample shows progress"
  (steps
    (click (role button :name "Load the sample"))
    (progress-effect 1 receiving 1200000 4800000)
    (expect-text (test-id "note") "Fetching sample: 1.2 of 4.8 MB")
    (expect-pending-effects 1)
    (mark-metrics)
    (hold-reports)
    (progress-effect 1 receiving 2300000 unknown)
    (progress-effect 1 receiving 3400000 unknown)
    (release-reports)
    (expect-text (test-id "note") "Fetching sample: 3.4 MB")
    (expect-metric-delta effects_progress 1)
    (stub-http "sample" :url "sample.csv" :status 200 :headers (("content-type" "text/csv")) :body "city,country\nTokyo,Japan\n")
    (run-effect 1)
    (expect-text (test-id "note") "")
    (expect-text (test-id "source") "sample.csv, 25 bytes")
  )
)
