(test "Field notes — a note saved after a reload takes an id no stored note holds"
  (setup
    (seed 7)
    (initial-online offline)
    (local-storage "field-notes:notes" "n0|0|1|r7|Generator hours"))
  (steps
    (fill (label "Note body") "Pump pressure log")
    (click (role button :name "Save note"))
    (expect-text (test-id "captured-n-63cbe1e459320dd7") "just now")
    (expect-no-attr (test-id "captured-n-63cbe1e459320dd7") datetime)
    (navigate "/after-reload")
    (expect-value (label "Body n-63cbe1e459320dd7") "Pump pressure log")
    (expect-text (test-id "captured-n-63cbe1e459320dd7") "Capture time unknown")
    (expect-no-attr (test-id "captured-n-63cbe1e459320dd7") datetime)
    (fill (label "Note body") "Tank level 42")
    (click (role button :name "Save note"))
    (run-effect 1)
    (expect-value (label "Body n-9e5651b0ef953636") "Tank level 42")
    (expect-value (label "Body n-63cbe1e459320dd7") "Pump pressure log")
    (expect-local-storage "field-notes:notes" "n0|0|1|r7|unknown|Generator hours;n-63cbe1e459320dd7|1|0|r0|unknown|Pump pressure log;n-9e5651b0ef953636|2|0|r0|0|Tank level 42")))
