(test "Field notes — a note saved where a synced note was deleted is sent"
  (setup
    (seed 7)
    (local-storage "field-notes:notes" "s1|0|1|s1:1|Pump pressure log"))
  (steps
    (expect-visible (role region :name "Note s1"))
    (stub-http "sync old" :url "/api/notes/sync" :status 200 :body "s1#s1:1")
    (run-effect 1)
    (expect-text (test-id "status-s1") "Synced")
    (click (role button :name "Delete note s1"))
    (expect-absent (role region :name "Note s1"))
    (fill (label "Note body") "Tank level 42")
    (click (role button :name "Save note"))
    (run-effect 2)
    (expect-text (test-id "status-n-63cbe1e459320dd7") "Draft")
    (fill (label "Body n-63cbe1e459320dd7") "Tank level 43")
    (click (role button :name "Queue note n-63cbe1e459320dd7"))
    (expect-text (test-id "status-n-63cbe1e459320dd7") "Syncing")
    (expect-pending-effects 1)
    (stub-http "sync new" :url "/api/notes/sync" :status 200 :body "n-63cbe1e459320dd7#n-63cbe1e459320dd7:1")
    (run-effect 3)
    (expect-text (test-id "status-n-63cbe1e459320dd7") "Synced")
    (expect-pending-effects 0)
    (expect-local-storage "field-notes:notes" "n-63cbe1e459320dd7|0|1|n-63cbe1e459320dd7:1|0|Tank level 43")))
