(test "Flight search — latest wins: a superseded response is ignored"
  (steps
    ; Given the state established by earlier scenarios
    (resolve-task "flight-search" "AU101,Aurora,06:00,305,0,145;BO220,Borealis,09:30,210,1,215;CE310,Cirrus,07:15,480,0,130;DE440,Aurora,14:05,265,2,300")
    (mark-metrics)
    (select-option (label "Sort by") "duration")
    (mark-metrics)
    (select-option (label "Sort by") "departure")
    (select-option (label "Airline") "Aurora")
    (resolve-task "flight-search" "AU101,Aurora,06:00,305,0,145;BO220,Borealis,09:30,210,1,215;CE310,Cirrus,07:15,480,0,130;DE440,Aurora,14:05,265,2,300")
    (select-option (label "Airline") "any")
    (select-option (label "Sort by") "price")
    (resolve-task "flight-search" "AU101,Aurora,06:00,305,0,145;BO220,Borealis,09:30,210,1,215;CE310,Cirrus,07:15,480,0,130;DE440,Aurora,14:05,265,2,300")
    (select-option (label "Max stops") "0")
    (resolve-task "flight-search" "AU101,Aurora,06:00,305,0,145;BO220,Borealis,09:30,210,1,215;CE310,Cirrus,07:15,480,0,130;DE440,Aurora,14:05,265,2,300")
    (select-option (label "Airline") "Aurora")
    (resolve-task "flight-search" "AU101,Aurora,06:00,305,0,145;BO220,Borealis,09:30,210,1,215;CE310,Cirrus,07:15,480,0,130;DE440,Aurora,14:05,265,2,300")
    (select-option (label "Max price") "200")
    (resolve-task "flight-search" "AU101,Aurora,06:00,305,0,145;BO220,Borealis,09:30,210,1,215;CE310,Cirrus,07:15,480,0,130;DE440,Aurora,14:05,265,2,300")
    (select-option (label "Sort by") "duration")
    (select-option (label "Departure date") "2026-09-02")
    (resolve-task "flight-search" "")
    (select-option (label "Departure date") "2026-09-03")
    (reject-task "flight-search" "flight search backend unavailable for this deterministic scenario payload")

    ; latest wins: a superseded response is ignored

    (select-option (label "Airline") "Borealis")
    (expect-pending-task "flight-search" 1)
    (select-option (label "Max price") "any")
    (expect-pending-task "flight-search" 1)
    (expect-canceled-task "flight-search" 1)
    (expect-text (test-id "request-key") "Request: 2026-09-03|0|any|Borealis")
    (mark-metrics)
    (resolve-stale-task "flight-search" "ZZ999,Zephyr,05:00,100,0,90")
    (expect-pending-task "flight-search" 1)
    (expect-text (test-id "search-status") "Search status: loading")
    (expect-text (test-id "result-summary") "Fetching flights")
    (expect-text (test-id "result-order") "Result order: none")
    (expect-absent (test-id "flight-row-ZZ999"))
    (expect-metric-delta stale_task_results_ignored 1)
    (expect-metric-delta rows_created 0)
    (resolve-task "flight-search" "AU101,Aurora,06:00,305,0,145;BO220,Borealis,09:30,210,1,215;CE310,Cirrus,07:15,480,0,130;DE440,Aurora,14:05,265,2,300")
    (expect-pending-task "flight-search" 0)
    (expect-text (test-id "search-status") "Search status: results ready")
    (expect-text (test-id "search-error") "No search error")
    (expect-text (test-id "result-order") "Result order: none")
    (expect-text (test-id "result-summary") "0 of 4 flights match the local filters.")
  )
)
