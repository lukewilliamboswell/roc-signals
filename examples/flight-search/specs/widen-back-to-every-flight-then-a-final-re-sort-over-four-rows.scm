(test "Flight search — widen back to every flight, then a final re sort over four rows"
  (steps
    ; Given the state established by earlier scenarios
    (resolve-task "flight-search" "QF421,Qantas,06:00,305,0,145;VA518,Virgin Australia,09:30,210,1,215;JQ722,Jetstar,07:15,480,0,130;QF876,Qantas,14:05,265,2,300")
    (mark-metrics)
    (select-option (label "Sort by") "duration")
    (mark-metrics)
    (select-option (label "Sort by") "departure")
    (select-option (label "Airline") "Qantas")
    (resolve-task "flight-search" "QF421,Qantas,06:00,305,0,145;VA518,Virgin Australia,09:30,210,1,215;JQ722,Jetstar,07:15,480,0,130;QF876,Qantas,14:05,265,2,300")
    (select-option (label "Airline") "any")
    (select-option (label "Sort by") "price")
    (resolve-task "flight-search" "QF421,Qantas,06:00,305,0,145;VA518,Virgin Australia,09:30,210,1,215;JQ722,Jetstar,07:15,480,0,130;QF876,Qantas,14:05,265,2,300")
    (select-option (label "Max stops") "0")
    (resolve-task "flight-search" "QF421,Qantas,06:00,305,0,145;VA518,Virgin Australia,09:30,210,1,215;JQ722,Jetstar,07:15,480,0,130;QF876,Qantas,14:05,265,2,300")
    (select-option (label "Airline") "Qantas")
    (resolve-task "flight-search" "QF421,Qantas,06:00,305,0,145;VA518,Virgin Australia,09:30,210,1,215;JQ722,Jetstar,07:15,480,0,130;QF876,Qantas,14:05,265,2,300")
    (select-option (label "Max price") "200")
    (resolve-task "flight-search" "QF421,Qantas,06:00,305,0,145;VA518,Virgin Australia,09:30,210,1,215;JQ722,Jetstar,07:15,480,0,130;QF876,Qantas,14:05,265,2,300")
    (select-option (label "Sort by") "duration")
    (select-option (label "Departure date") "2026-09-02")
    (resolve-task "flight-search" "")
    (select-option (label "Departure date") "2026-09-03")
    (reject-task "flight-search" "flight search backend unavailable for this deterministic scenario payload")
    (select-option (label "Airline") "Virgin Australia")
    (select-option (label "Max price") "any")
    (mark-metrics)
    (resolve-stale-task "flight-search" "NZ104,Air New Zealand,05:00,100,0,90")
    (resolve-task "flight-search" "QF421,Qantas,06:00,305,0,145;VA518,Virgin Australia,09:30,210,1,215;JQ722,Jetstar,07:15,480,0,130;QF876,Qantas,14:05,265,2,300")

    ; widen back to every flight, then a final re sort over four rows

    (select-option (label "Max stops") "any")
    (expect-pending-task "flight-search" 1)
    (resolve-task "flight-search" "QF421,Qantas,06:00,305,0,145;VA518,Virgin Australia,09:30,210,1,215;JQ722,Jetstar,07:15,480,0,130;QF876,Qantas,14:05,265,2,300")
    (expect-text (test-id "result-order") "Result order: VA518")
    (expect-text (test-id "result-summary") "Showing 1 of 4 flights.")
    (select-option (label "Airline") "any")
    (expect-pending-task "flight-search" 1)
    (resolve-task "flight-search" "QF421,Qantas,06:00,305,0,145;VA518,Virgin Australia,09:30,210,1,215;JQ722,Jetstar,07:15,480,0,130;QF876,Qantas,14:05,265,2,300")
    (expect-pending-task "flight-search" 0)
    (expect-text (test-id "result-order") "Result order: JQ722, QF421, VA518, QF876")
    (expect-text (test-id "result-summary") "Showing 4 of 4 flights.")
    (mark-metrics)
    (select-option (label "Sort by") "price")
    (expect-pending-task "flight-search" 0)
    (expect-text (test-id "result-order") "Result order: VA518, QF876, QF421, JQ722")
    (expect-metric-delta rows_created 0)
    (expect-metric-delta rows_reused 4)
    (expect-metric-delta rows_removed 0)
  )
)
