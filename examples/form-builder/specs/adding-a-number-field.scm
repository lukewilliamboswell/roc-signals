(test "Form builder — adding a number field"
  (steps
    ; Bring the page to the state this spec starts from.
    (fill (label "Answer f1") "Ada")
    (fill (label "Answer f2") "ada@example")
    (fill (label "Answer f2") "ada@example.com")
    (click (role button :name "Submit form"))
    (click (role button :name "Settings f1"))
    (fill (label "Minimum f1") "5")
    (fill (label "Minimum f1") "2")
    (click (role button :name "Done f1"))
    (mark-metrics)
    (fill (label "Label f1") "Given name")
    (click (role button :name "Settings f2"))
    (uncheck (label "Required f2"))
    (check (label "Required f2"))

    ; adding a number field
    (click (role button :name "Done f2"))
    (click (role button :name "Add number field"))
    (expect-text (test-id "designer-status") "3")
    (expect-visible (role region :name "Field f3"))
    (expect-visible (role region :name "Preview field f3"))
    (expect-text (test-id "field-f3-summary") "Optional")
    (expect-text (test-id "preview-f3-label") "Number 3")
    (expect-text (test-id "preview-f3-verdict") "Valid")
    (expect-text (test-id "submittable-state") "Ready to submit")
    (fill (label "Answer f3") "abc")
    (expect-text (test-id "preview-f3-verdict") "Enter a whole number")
    (fill (label "Answer f3") "42")
    (expect-text (test-id "preview-f3-verdict") "Valid")
    (click (role button :name "Settings f3"))
    (fill (label "Maximum f3") "10")
    (expect-text (test-id "preview-f3-verdict") "Must be at most 10")
    (expect-text (test-id "submittable-state") "Not ready")
    ; contradictory rule: minimum greater than maximum
    (fill (label "Minimum f3") "20")
    (expect-text (test-id "field-f3-summary") "Rule error: minimum is greater than maximum")
    (expect-text (test-id "preview-f3-verdict") "Rule error: minimum is greater than maximum")
    (expect-attr (label "Minimum f3") aria-invalid "true")
    (expect-attr (label "Maximum f3") aria-invalid "true")
    (expect-text (test-id "submittable-state") "Not ready")
    (fill (label "Maximum f3") "50")
    (fill (label "Minimum f3") "20")
    (expect-no-attr (label "Minimum f3") aria-invalid)
    (expect-text (test-id "preview-f3-verdict") "Valid")
    (click (role button :name "Done f3"))
    (fill (label "Answer f3") "5")
    (expect-text (test-id "preview-f3-verdict") "Must be at least 20")
    (fill (label "Answer f3") "25")
    (expect-text (test-id "preview-f3-verdict") "Valid")
    (expect-text (test-id "submittable-state") "Ready to submit")
  )
)
