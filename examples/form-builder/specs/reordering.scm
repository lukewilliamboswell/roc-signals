(test "Form builder — reordering"
  (steps
    ; Bring the page to the state this spec starts from.
    (fill (label "Answer f1") "Ada")
    (fill (label "Answer f2") "ada@example")
    (fill (label "Answer f2") "ada@example.com")
    (click (role button :name "Submit form"))
    (click (role button :name "Settings f1"))
    (fill (label "Minimum f1") "5")
    (fill (label "Minimum f1") "2")
    (click (role button :name "Done f1"))
    (mark-metrics)
    (fill (label "Label f1") "Given name")
    (click (role button :name "Settings f2"))
    (uncheck (label "Required f2"))
    (check (label "Required f2"))
    (click (role button :name "Done f2"))
    (click (role button :name "Add number field"))
    (fill (label "Answer f3") "abc")
    (fill (label "Answer f3") "42")
    (click (role button :name "Settings f3"))
    (fill (label "Maximum f3") "10")
    (fill (label "Minimum f3") "20")
    (fill (label "Maximum f3") "50")
    (fill (label "Minimum f3") "20")
    (click (role button :name "Done f3"))
    (fill (label "Answer f3") "5")
    (fill (label "Answer f3") "25")
    (click (role button :name "Add select field"))
    (click (role button :name "Settings f4"))
    (fill (label "Options f4") "Small, Medium, Large")
    (click (role button :name "Done f4"))
    (select-option (label "Answer f4") "Medium")
    (click (role button :name "Settings f4"))
    (fill (label "Options f4") "Small, Large")
    (click (role button :name "Done f4"))
    (select-option (label "Answer f4") "Large")
    (click (role button :name "Add checkbox field"))
    (click (role button :name "Settings f5"))
    (check (label "Required f5"))
    (click (role button :name "Done f5"))
    (check (label "Answer f5"))
    (click (role button :name "Add text field"))
    (click (role button :name "Add email field"))

    ; reordering
    ; Reordering exchanges the places of two fields, not a rebuild: the
    ; designer's view and the preview's each move one row and wake the two
    ; rows written, rows keep their identity and every answer travels with
    ; its field. A view compares no list of rows, so it counts none as
    ; reused.
    (mark-metrics)
    (click (role button :name "Move up f2"))
    (expect-metric-delta rows_created 0)
    (expect-metric-delta rows_removed 0)
    (expect-metric-delta rows_reused 0)
    (expect-metric-delta rows_moved 2)
    (expect-metric-delta rows_updated 4)
    (expect-metric-delta scopes_created 0)
    (expect-metric-delta scopes_disposed 0)
    (expect-value (label "Answer f2") "ada@example.com")
    (expect-value (label "Answer f4") "Large")
    (expect-checked (label "Answer f5") true)
    (expect-value (label "Label f1") "Given name")
    (expect-text (test-id "preview-status") "0")
    (click (role button :name "Move down f2"))
    (expect-value (label "Answer f2") "ada@example.com")
    (expect-value (label "Answer f1") "Ada")
    ; moving the first field up is a no-op
    (click (role button :name "Move up f1"))
    (click (role button :name "Move up f1"))
    (expect-text (test-id "designer-status") "7")
    (expect-value (label "Answer f1") "Ada")
    ; moving the last field down is a no-op
    (click (role button :name "Move down f7"))
    (expect-text (test-id "designer-status") "7")
  )
)
