(test "Form builder — a saved definition keeps its fields and rules across a reload"
  (steps
    (fill (label "Label f1") "Attendee")
    (click (role button :name "Add number field"))
    (fill (label "Label f3") "Age")
    (click (role button :name "Settings f3"))
    (fill (label "Minimum f3") "18")
    (click (role button :name "Done f3"))
    (click (role button :name "Move up f3"))
    (click (role button :name "Move up f3"))
    (fill (label "Answer f1") "Ada")
    (fill (label "Answer f2") "ada@example.com")
    (fill (label "Answer f3") "30")
    (click (role button :name "Submit form"))
    (expect-text (test-id "submissions-count") "1")
    (click (role button :name "Save definition"))
    (expect-text (test-id "storage-status") "Definition saved in this browser.")
    (click (role button :name "Add select field"))
    (expect-visible (role region :name "Field f4"))
    (fill (label "Label f1") "Changed since save")
    (click (role button :name "Reopen saved definition"))
    (expect-text (test-id "storage-status") "Saved definition reopened.")
    (expect-absent (role region :name "Field f4"))
    (expect-value (label "Label f1") "Attendee")
    (expect-value (label "Answer f1") "")
    (expect-value (label "Answer f3") "")
    (expect-text (test-id "submissions-count") "0")
    (click (role button :name "Add text field"))
    (expect-visible (role region :name "Field f5"))

    (navigate "/?again")
    (expect-value (label "Label f1") "Full name")
    (click (role button :name "Reopen saved definition"))
    (expect-text (test-id "storage-status") "Saved definition reopened.")
    (expect-value (label "Label f1") "Attendee")
    (expect-text (test-id "preview-f3-label") "Age")
    (mark-metrics)
    (click (role button :name "Move up f3"))
    (click (role button :name "Move down f2"))
    (expect-metric-delta rows_moved 0)
    (click (role button :name "Move down f3"))
    (expect-metric-delta rows_moved 2)
    (fill (label "Answer f3") "17")
    (expect-text (test-id "preview-f3-verdict") "Must be at least 18")
    (click (role button :name "Add text field"))
    (expect-visible (role region :name "Field f4"))))
