(test "Form Builder — invalid submit reveals the first problem and valid answers hide the summary"
  (steps
    (expect-disabled (role button :name "Submit form") false)
    (click (role button :name "Submit form"))
    (expect-scrolls 1)
    (expect-scroll 1 (label "Answer f1") into-view)
    (expect-focused (label "Answer f1"))
    (expect-shown (test-id "form-problems") popover)
    (expect-text (test-id "submissions-count") "0")
    (fill (label "Answer f1") "Ada")
    (expect-shown (test-id "form-problems") popover)
    (fill (label "Answer f2") "ada@example.com")
    (expect-shown (test-id "form-problems") hidden)
    (expect-scrolls 1)
    (click (role button :name "Submit form"))
    (expect-text (test-id "submissions-count") "1")
    (expect-shown (test-id "form-problems") hidden)
  )
)
