(test "Log Explorer — a sample log is written by a task to a new file, and explored like a chosen one"
  (steps
    (fill (label "Entries") "0")
    (click (role button :name "Generate a sample log"))
    (expect-text (test-id "note") "Enter a number of entries from 1 to 2,000,000.")
    (expect-pending-effects 0)
    (fill (label "Entries") "300")
    (click (role button :name "Generate a sample log"))
    (expect-text (test-id "log") "Generating a sample log of 300 entries…")
    (expect-pending-work "roc-signals.example/log-explorer/generate" 1)
    (run-effect 1)
    (expect-text (test-id "log") "sample-300.log, 21 KiB")
    (expect-text (test-id "note") "")
    (run-effect 2)
    (expect-text (test-id "overview") "321 lines, 300 entries, from 2026-11-11T08:00:00.088Z to 2026-11-11T08:00:15.286Z")
    (expect-text (test-id "sources") "Busiest sources: api 103, cache 47, db 46, auth 32, mailer 27 (of 9)")
    (expect-files 1)
  )
)
