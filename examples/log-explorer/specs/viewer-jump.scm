(test "Log Explorer — a jump scrolls once and its echo asks for no second window"
  (setup
    (file "app.txt" "text/plain" "2026-11-11T08:00:00Z INFO api: line\n" 200)
    (file "short.txt" "text/plain" "2026-11-11T08:00:00Z INFO api: short\n" 3)
    (file "long.txt" "text/plain" "2026-11-11T08:00:00Z INFO api: long\n" 400))
  (steps
    (choose-files (label "Log file") "app.txt")
    (run-effect 1)
    (click (role button :name "Viewer"))
    (report-size (test-id "viewer-viewport") 800 400)
    (run-effect 2)
    (expect-scrolls 1)
    (fill (label "Go to line") "71")
    (expect-scrolls 2)
    (expect-scroll 2 (test-id "viewer-viewport") to)
    (expect-pending-work "roc-signals.example/log-explorer/window" 1)
    (run-effect 3)
    (expect-text (test-id "viewer-status") "Lines 71–90 of 200.")
    (expect-text (test-id "line-71") "2026-11-11T08:00:00Z INFO api: line")
    (expect-pending-effects 0)
    ; Opening another file while Viewer is mounted drops the old total.
    (choose-files (label "Log file") "short.txt")
    (expect-attr (test-id "viewer-spacer") style "height:0px;position:relative")
    (run-effect 4)
    (run-effect 5)
    (expect-text (test-id "viewer-status") "Lines 1–3 of 3.")
    (expect-attr (test-id "viewer-spacer") style "height:60px;position:relative")
    (expect-value (label "Go to line") "1")
    (choose-files (label "Log file") "long.txt")
    (expect-attr (test-id "viewer-spacer") style "height:0px;position:relative")
    (run-effect 6)
    (run-effect 7)
    (expect-text (test-id "viewer-status") "Lines 1–20 of 400.")
    (expect-attr (test-id "viewer-spacer") style "height:8000px;position:relative")
    (expect-pending-effects 0)))
