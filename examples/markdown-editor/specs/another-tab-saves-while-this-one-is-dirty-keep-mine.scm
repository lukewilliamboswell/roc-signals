(test "Markdown editor — another tab saves while this one is dirty keep mine"
  (setup (local-storage "md.document" "# Original"))
  (steps
    (fill (label "Markdown source") "# Mine")
    (storage-elsewhere "md.document" "# Theirs")
    (expect-value (label "Markdown source") "# Mine")
    (expect-visible (role button :name "Load the other tab's version"))
    (click (role button :name "Keep mine"))
    (expect-value (label "Markdown source") "# Mine")
    (expect-local-storage "md.document" "# Theirs")
    (expect-session-storage "md.draft" "# Mine")
    (expect-text (test-id "document-status") "Unsaved changes")
    (storage-elsewhere "md.document" "# Theirs again")
    (click (role button :name "Load the other tab's version"))
    (expect-value (label "Markdown source") "# Theirs again")
    (expect-session-storage "md.draft" "# Theirs again")
    (expect-text (test-id "document-status") "Saved")
    (expect-absent (role button :name "Keep mine"))
    (leave-page "/accepted" unasked))
)
