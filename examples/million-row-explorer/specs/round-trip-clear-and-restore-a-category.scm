(test "Million-Row Explorer — round trip: a category cleared and restored, each question answered by every shard"
  (setup (initial-location "/?orders=200000"))
  (steps
    (run-effect 1)
    (run-effect 2)
    (run-effect 3)
    (run-effect 4)
    (expect-text (test-id "orders") "200,000")
    (mark-metrics)
    (uncheck (label "Toys"))
    (run-effect 5)
    (run-effect 6)
    (run-effect 7)
    (run-effect 8)
    (expect-text (test-id "orders") "181,719")
    (check (label "Toys"))
    (run-effect 9)
    (run-effect 10)
    (run-effect 11)
    (run-effect 12)
    (expect-text (test-id "orders") "200,000")
    (expect-metric-delta effects_issued 8)
    (expect-metric-delta effects_delivered 8)
    (expect-metric-delta effects_cancelled 0)
  )
)
