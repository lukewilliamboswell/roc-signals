(test "Reading List — edit details without changing the book's identity or shelf"
  (steps
    (answer-port 1 reply "[{\"id\":\"b1\",\"title\":\"Dune\",\"author\":\"Frank Herbert\",\"shelf\":\"WantToRead\",\"added_ms\":\"10\"}]")
    (click (role button :name "Edit Dune"))
    (expect-focused (label "Book title"))
    (expect-value (label "Book title") "Dune")
    (expect-value (label "Book author") "Frank Herbert")
    (fill (label "Book title") " ")
    (expect-disabled (role button :name "Save details") true)
    (click (role button :name "Cancel edit"))
    (expect-absent (label "Book title"))
    (expect-focused (role button :name "Edit Dune"))
    (expect-port-sends "roc-signals.example/reading-list/edit" 0)

    (click (role button :name "Edit Dune"))
    (expect-value (label "Book title") "Dune")
    (fill (label "Book title") " Dune Messiah ")
    (fill (label "Book author") " F. Herbert ")
    ; A shelf move from another tab keeps the open draft.
    (emit-port "roc-signals.example/reading-list/stored" "[{\"id\":\"b1\",\"title\":\"Dune\",\"author\":\"Frank Herbert\",\"shelf\":\"Reading\",\"added_ms\":\"10\"}]")
    (expect-value (label "Book title") " Dune Messiah ")
    (expect-visible (role button :name "Finish Dune"))
    (click (role button :name "Save details"))
    (expect-absent (label "Book title"))
    (expect-focused (role button :name "Edit Dune Messiah"))
    (expect-visible (text "F. Herbert"))
    (expect-visible (role button :name "Finish Dune Messiah"))
    (expect-port-sent "roc-signals.example/reading-list/edit" 1 "{\"author\":\"F. Herbert\",\"id\":\"b1\",\"title\":\"Dune Messiah\"}")
    (expect-port-sends "roc-signals.example/reading-list/move" 0)
    (expect-text (test-id "status") "1 book")))
