(test "Reading List — a timer samples action time and a new document gets its next seed"
  (setup (seed 7) (initial-time 10))
  (steps
    (answer-port 1 reply "[]")
    (fill (label "Title") "Dune")
    (click (role button :name "Add book"))
    (mark-metrics)
    (set-time -1)
    (expect-metric-delta effects_delivered 0)
    (expect-metric-delta patches_emitted 0)
    (run-effect 2)
    (expect-port-call 3 "roc-signals.example/reading-list/add" "{\"added_ms\":\"-1\",\"author\":\"\",\"id\":\"b-63cbe1e459320dd7\",\"shelf\":\"WantToRead\",\"title\":\"Dune\"}")
    (answer-port 3 reply "{\"added_ms\":\"-1\",\"author\":\"\",\"id\":\"b-63cbe1e459320dd7\",\"shelf\":\"WantToRead\",\"title\":\"Dune\"}")
    (expect-text (test-id "status") "1 book")
    (navigate "/?another-document")
    (answer-port 1 reply "[{\"added_ms\":\"-1\",\"author\":\"\",\"id\":\"b-63cbe1e459320dd7\",\"shelf\":\"WantToRead\",\"title\":\"Dune\"}]")
    (fill (label "Title") "Piranesi")
    (click (role button :name "Add book"))
    (advance-time 2)
    (run-effect 2)
    (expect-port-call 3 "roc-signals.example/reading-list/add" "{\"added_ms\":\"1\",\"author\":\"\",\"id\":\"b-9e5651b0ef953636\",\"shelf\":\"WantToRead\",\"title\":\"Piranesi\"}")
    (answer-port 3 reply "{\"added_ms\":\"1\",\"author\":\"\",\"id\":\"b-9e5651b0ef953636\",\"shelf\":\"WantToRead\",\"title\":\"Piranesi\"}")
    (expect-text (test-id "status") "2 books")
  )
)
