(test "Keyboard navigation follows the listed rows and preserves ordinary caret keys while typing"
  (steps
    (press (label "B2") "ArrowRight")
    (expect-focused (label "C2"))
    (press "ArrowDown")
    (expect-focused (label "C3"))
    (press "Control+ArrowUp")
    (expect-focused (label "C1"))
    (press "Meta+ArrowDown")
    (expect-focused (label "C12"))
    (click (role button :name "Reverse row order"))
    (press (label "C2") "Control+ArrowDown")
    (expect-focused (label "C1"))
    (fill (label "B2") "1500")
    (mark-metrics)
    (press "ArrowRight")
    (expect-focused (label "B2"))
    (expect-metric-delta dirty_source_roots 0)
    (press "F3")
    (expect-metric-delta dirty_source_roots 0)))
