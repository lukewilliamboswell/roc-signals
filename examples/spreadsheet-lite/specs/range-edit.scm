(test "Copy, paste and clear a rectangular selection in sheet order"
  (steps
    (press (label "C3") "Shift+ArrowLeft")
    (press "Shift+ArrowUp")
    (expect-focused (label "B2"))
    (expect-text (test-id "stat-selection") "B2:C3 · 3700")
    (press "Control+c")
    (expect-clipboard "1200\t1300\n400\t=B3*2")
    (expect-clipboard-writes 1)
    (expect-text (test-id "range-status") "Copied selected cells")

    (paste-text (label "B2") "10\t20\r\n3\t=B3*2\r\n")
    (expect-text (test-id "range-status") "Pasted cells")
    (expect-value (label "B2") "10")
    (expect-value (label "C2") "20")
    (expect-value (label "D2") "30")
    (expect-value (label "C3") "6")
    (expect-value (label "D3") "9")
    (expect-value (label "D5") "439")
    (expect-text (test-id "stat-selection") "B2:C3 · 39")

    (press "Delete")
    (expect-text (test-id "range-status") "Cleared selected cells")
    (expect-value (label "B2") "")
    (expect-value (label "C2") "")
    (expect-value (label "B3") "")
    (expect-value (label "C3") "")
    (expect-value (label "D2") "0")
    (expect-value (label "D3") "0")
    (expect-value (label "D5") "400")
    (expect-value (label "A3") "Cloud")
    (expect-text (test-id "stat-selection") "B2:C3 · 0")
    (fill (label "B2") "75")
    (press "Escape")
    (expect-value (label "B2") "")))
