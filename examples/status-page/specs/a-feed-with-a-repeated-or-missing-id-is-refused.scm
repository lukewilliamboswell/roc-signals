(test "Status page — an incident feed with a repeated or missing id is refused where it arrives"
  (steps
    (stub-http "api" :url "/api/status/api" :status 200 :body "operational|99.98")
    (run-effect 1)
    (stub-http "web" :url "/api/status/web" :status 200 :body "operational|99.99")
    (run-effect 2)
    (stub-http "database" :url "/api/status/database" :status 200 :body "operational|99.90")
    (run-effect 3)
    (stub-http "notifications" :url "/api/status/notifications" :status 200 :body "operational|99.95")
    (run-effect 4)
    ; The timeline draws incidents keyed by id: two incidents under one id
    ; are a malformed feed, which the page says, drawing no incident.
    (stub-http "incidents" :url "/api/status/incidents" :status 200 :body "inc-1~minor~First~10:02@Investigating#inc-1~major~Second~10:05@Investigating")
    (run-effect 5)
    (expect-text (test-id "incident-feed-status") "Incident feed could not be read: two incidents share the id inc-1")
    (expect-text (test-id "open-incident-count") "0")
    (expect-visible (text "No incidents reported in the last 90 days."))
    (expect-absent (role region :name "Incident inc-1"))
    ; An incident without an id is refused the same way.
    (tick-interval 5000)
    (stub-http "api" :url "/api/status/api" :status 200 :body "operational|99.98")
    (run-effect 6)
    (stub-http "web" :url "/api/status/web" :status 200 :body "operational|99.99")
    (run-effect 7)
    (stub-http "database" :url "/api/status/database" :status 200 :body "operational|99.90")
    (run-effect 8)
    (stub-http "notifications" :url "/api/status/notifications" :status 200 :body "operational|99.95")
    (run-effect 9)
    (stub-http "incidents" :url "/api/status/incidents" :status 200 :body "inc-1~minor~First#~major~No id")
    (run-effect 10)
    (expect-text (test-id "incident-feed-status") "Incident feed could not be read: incident 2 has no id")
    ; A well-formed feed after it is drawn as usual.
    (tick-interval 5000)
    (stub-http "api" :url "/api/status/api" :status 200 :body "operational|99.98")
    (run-effect 11)
    (stub-http "web" :url "/api/status/web" :status 200 :body "operational|99.99")
    (run-effect 12)
    (stub-http "database" :url "/api/status/database" :status 200 :body "operational|99.90")
    (run-effect 13)
    (stub-http "notifications" :url "/api/status/notifications" :status 200 :body "operational|99.95")
    (run-effect 14)
    (stub-http "incidents" :url "/api/status/incidents" :status 200 :body "inc-1~minor~First~10:02@Investigating#inc-2~major~Second~10:05@Investigating")
    (run-effect 15)
    (expect-text (test-id "incident-feed-status") "Incident feed: updated")
    (expect-text (test-id "open-incident-count") "2")
    (expect-visible (role region :name "Incident inc-1"))
    (expect-visible (role region :name "Incident inc-2"))
  )
)
