(test "Status page — The feed gives up after five attempts"
  (setup (seed 7))
  (steps
    (close-port "roc-signals.example/status-page/latency")
    (expect-text (test-id "live-status") "Connection lost: reconnecting in 1.160 s (attempt 1)")
    (run-effect 6)
    (close-port "roc-signals.example/status-page/latency")
    (expect-text (test-id "live-status") "Connection lost: reconnecting in 2.432 s (attempt 2)")
    (run-effect 7)
    (close-port "roc-signals.example/status-page/latency")
    (expect-text (test-id "live-status") "Connection lost: reconnecting in 4.308 s (attempt 3)")
    (run-effect 8)
    (close-port "roc-signals.example/status-page/latency")
    (expect-text (test-id "live-status") "Connection lost: reconnecting in 9.539 s (attempt 4)")
    (run-effect 9)
    (close-port "roc-signals.example/status-page/latency")
    (expect-text (test-id "live-status") "Connection lost: reconnecting in 19.934 s (attempt 5)")
    (run-effect 10)
    (close-port "roc-signals.example/status-page/latency")
    (expect-text (test-id "live-status") "Gave up after 5 attempts")
    (expect-pending-effects 5)
    (click (role button :name "Reconnect"))
    (expect-text (test-id "live-status") "Connecting to the latency feed")
    (expect-port-subscriptions "roc-signals.example/status-page/latency" 1)
  )
)
