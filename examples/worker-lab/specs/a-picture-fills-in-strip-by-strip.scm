(test "Worker Lab — A picture fills in strip by strip, in any order, then is composed, digested and saved"
  (steps
    (select-option (label "Workload") "draw")
    (fill (label "Jobs") "3")
    (fill (label "Weight") "1")
    (click (role button :name "Start"))
    (expect-pending-work "roc-signals.example/worker-lab/strip" 3)
    (expect-interval 100 1)
    (expect-text (test-id "picture") "0 of 3 strips drawn")
    (expect-text (test-id "strip-1") "drawing")
    (expect-visible (text "strip of 128 by 29 pixels, rows 1 to 29"))
    (run-effect 3)
    (expect-text (test-id "job-3") "done: 4790-byte strip, hash a8074ade")
    (expect-text (test-id "strip-3") "drawing")
    (expect-pending-effects 3)
    (run-effect 4)
    (expect-visible (test-id "strip-image-3"))
    (expect-text (test-id "picture") "1 of 3 strips drawn")
    (tick-interval 100)
    (run-effect 1)
    (run-effect 5)
    (expect-visible (test-id "strip-image-1"))
    (run-effect 2)
    (expect-text (test-id "job-1") "done: 4790-byte strip, hash 1781493c")
    (expect-text (test-id "job-2") "done: 4790-byte strip, hash 99ee8b8c")
    (expect-pending-effects 2)
    (expect-pending-work "roc-signals.example/worker-lab/compose" 1)
    (run-effect 6)
    (expect-text (test-id "composed") "mandelbrot-128x87.bmp, 12214 bytes")
    (expect-pending-effects 3)
    (run-effect 7)
    (run-effect 8)
    (run-effect 9)
    (expect-pending-effects 0)
    (expect-text (test-id "digest") "SHA-256 b3be2ce941ff4178281bb1f673eb2ffc1306964cb0ae4f3b93d51592b2e93d5c")
    (expect-visible (test-id "picture-image"))
    (expect-absent (test-id "strip-image-1"))
    (expect-text (test-id "picture") "All 3 strips drawn")
    (expect-text (test-id "checksum") "16269de9")
    (expect-text (test-id "draw-ticks") "1")
    (expect-interval 100 0)
    (expect-files 4)
    (click (role button :name "Save picture"))
    (expect-saves 1)
    (click (role button :name "Reset"))
    (expect-files 0)
    (expect-text (test-id "picture") "Choose \"Draw the Mandelbrot set\" and press Start.")
  )
)
