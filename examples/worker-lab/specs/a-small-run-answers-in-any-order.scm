(test "Worker Lab — A small run's answers and checksum do not depend on the order jobs finish in"
  (steps
    (fill (label "Jobs") "4")
    (fill (label "Weight") "1")
    ; Editing the parameters before a run starts nothing.
    (expect-pending-effects 0)
    (click (role button :name "Start"))
    (expect-pending-effects 4)
    (expect-text (test-id "job-1") "running")
    (expect-text (test-id "job-4") "running")
    (expect-text (test-id "running") "4")
    (expect-text (test-id "checksum") "pending")
    (expect-visible (text "primes in [1000000, 1002000)"))
    (expect-visible (text "primes in [1006000, 1008000)"))
    ; The jobs finish in an order the spec chooses; each answer lands in its
    ; own row.
    (run-effect 3)
    (expect-text (test-id "job-3") "done: 136 primes")
    (expect-text (test-id "job-1") "running")
    (run-effect 1)
    (run-effect 4)
    (expect-text (test-id "progress") "3 of 4 done")
    (expect-text (test-id "checksum") "pending")
    (run-effect 2)
    (expect-pending-effects 0)
    (expect-text (test-id "job-1") "done: 152 primes")
    (expect-text (test-id "job-2") "done: 153 primes")
    (expect-text (test-id "job-3") "done: 136 primes")
    (expect-text (test-id "job-4") "done: 158 primes")
    (expect-text (test-id "primes") "599")
    (expect-text (test-id "progress") "4 of 4 done")
    (expect-text (test-id "checksum") "df47e1c2")
    (expect-disabled (role button :name "Cancel") true)
  )
)
