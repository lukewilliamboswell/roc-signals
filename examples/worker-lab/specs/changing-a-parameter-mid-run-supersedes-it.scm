(test "Worker Lab — Changing a parameter mid-run supersedes the run, and a job refused at the bound retries"
  (steps
    (fill (label "Jobs") "20")
    (fill (label "Weight") "1")
    (click (role button :name "Start"))
    (run-effect 1)
    (run-effect 2)
    (run-effect 3)
    (run-effect 4)
    (run-effect 5)
    ; Jobs 6 to 20 are in flight (occurrences 6 to 20).
    (expect-text (test-id "job-20") "running")
    (expect-text (test-id "job-1") "done: 152 primes")
    ; A heavier weight restarts the run: every row now wants its new job.
    ; Rows 6 to 15 cancel their old request and issue the new one (21 to
    ; 30), and rows 16 to 20 go back to waiting and cancel theirs. Rows 1 to
    ; 5 asked first, while the old requests still held every slot, so the
    ; engine refused them; each refusal sends its job back to waiting, and
    ; the page admits it again at once now that slots are free (31 to 35).
    (mark-metrics)
    (fill (label "Weight") "2")
    (expect-pending-effects 15)
    ; The engine's own account: 15 old requests cancelled, 5 refused, and
    ; 10 + 5 new ones issued.
    (expect-metric-delta effects_cancelled 15)
    (expect-metric-delta effects_refused 5)
    (expect-metric-delta effects_issued 15)
    (expect-text (test-id "refused") "Refused at the in-flight bound and retried: 5")
    (expect-text (test-id "job-1") "running")
    (expect-text (test-id "job-16") "waiting")
    (expect-text (test-id "checksum") "pending")
    (run-effect 31)
    (expect-text (test-id "job-1") "done: 305 primes")
    (expect-text (test-id "job-16") "running")
    (run-effect 21)
    (expect-text (test-id "job-6") "done: 295 primes")
    (run-effect 22)
    (run-effect 23)
    (run-effect 24)
    (run-effect 25)
    (run-effect 26)
    (run-effect 27)
    (run-effect 28)
    (run-effect 29)
    (run-effect 30)
    (run-effect 32)
    (run-effect 33)
    (run-effect 34)
    (run-effect 35)
    (expect-pending-effects 5)
    (run-effect 40)
    (run-effect 39)
    (run-effect 38)
    (run-effect 37)
    (run-effect 36)
    (expect-pending-effects 0)
    (expect-text (test-id "job-16") "done: 285 primes")
    (expect-text (test-id "job-20") "done: 287 primes")
    (expect-text (test-id "primes") "5772")
    (expect-text (test-id "checksum") "a25f23d1")
    ; Fewer jobs mid-run: the rows beyond the new count are disposed with
    ; their jobs.
    (click (role button :name "Start"))
    (expect-pending-effects 15)
    (fill (label "Jobs") "3")
    (expect-pending-effects 3)
    (expect-absent (test-id "job-4"))
    (expect-text (test-id "job-3") "running")
  )
)
