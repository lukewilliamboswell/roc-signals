(test "Worker Lab — Jobs beyond the in-flight bound wait and are admitted one per finished job"
  (steps
    (fill (label "Jobs") "20")
    (fill (label "Weight") "1")
    (click (role button :name "Start"))
    ; The program allows 16 requests in flight and the heartbeat holds one,
    ; so 15 jobs run and 5 wait in the page.
    (expect-pending-effects 15)
    (expect-text (test-id "running") "15")
    (expect-text (test-id "waiting") "5")
    (expect-text (test-id "job-15") "running")
    (expect-text (test-id "job-16") "waiting")
    (expect-text (test-id "job-20") "waiting")
    ; Each finished job lets the lowest waiting job in, so the bound is never
    ; met and nothing is refused.
    (run-effect 9)
    (expect-text (test-id "job-16") "running")
    (expect-text (test-id "job-17") "waiting")
    (expect-pending-effects 15)
    (run-effect 1)
    (run-effect 2)
    (run-effect 3)
    (run-effect 4)
    (expect-text (test-id "waiting") "0")
    (expect-text (test-id "job-20") "running")
    (expect-pending-effects 15)
    (run-effect 5)
    (run-effect 6)
    (run-effect 7)
    (run-effect 8)
    (run-effect 10)
    (expect-pending-effects 10)
    (run-effect 20)
    (run-effect 19)
    (run-effect 18)
    (run-effect 17)
    (run-effect 16)
    (run-effect 15)
    (run-effect 14)
    (run-effect 13)
    (run-effect 12)
    (run-effect 11)
    (expect-pending-effects 0)
    (expect-text (test-id "progress") "20 of 20 done")
    (expect-text (test-id "job-19") "done: 143 primes")
    (expect-text (test-id "primes") "2905")
    (expect-text (test-id "checksum") "c9387502")
    (expect-text (test-id "refused") "Refused at the in-flight bound and retried: 0")
  )
)
