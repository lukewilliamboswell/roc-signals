(test "Worker Lab — Tiles come back as blocks of bytes the page hashes"
  (steps
    (select-option (label "Workload") "tiles")
    (fill (label "Jobs") "4")
    (fill (label "Weight") "2")
    (click (role button :name "Start"))
    (expect-pending-effects 4)
    (expect-visible (text "tile of 8 by 8 pixels"))
    (run-effect 4)
    (run-effect 2)
    (run-effect 1)
    (run-effect 3)
    (expect-text (test-id "job-1") "done: 64 bytes, hash f1c7eb26")
    (expect-text (test-id "job-2") "done: 64 bytes, hash 769ea4cc")
    (expect-text (test-id "job-3") "done: 64 bytes, hash 5f1af15e")
    (expect-text (test-id "job-4") "done: 64 bytes, hash 75d05bd3")
    (expect-text (test-id "tile-bytes") "256")
    (expect-text (test-id "checksum") "ae90a725")
  )
)
