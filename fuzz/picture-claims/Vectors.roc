import pf.Dom
import pf.PictureClaims
import pf.PictureCodec

## Fixed byte vectors authored with Python struct/hashlib independently of
## both Roc encoders and the browser implementation. Hashes are host evidence;
## these pure checks compare every byte supplied to the host.
Vectors :: [].{
	check : {} -> {}
	check = |_props| {
		for vector in picture_vectors {
			envelope = PictureCodec.read(vector.envelope, {}) ?? crash "picture-claims: independent envelope fixture refused"
			parts = PictureCodec.parts(envelope)
			physical = match vector.name {
				"empty" => []
				"unicode" => [Text("é😀\r")]
				"hash_lookalike" => [Text(Str.from_utf8(List.repeat(17, 32)) ?? crash "valid ASCII fixture")]
				"svg" => [Element({ name: { namespace: Dom.svg_namespace, prefix: "p", local: "g" }, attributes: [({ namespace: "http://www.w3.org/2000/xmlns/", prefix: "xmlns", local: "p" }, Dom.svg_namespace), ({ namespace: "urn:attr", prefix: "a", local: "key" }, "é"), ({ namespace: "", prefix: "", local: "pathLength" }, "12")], children: 1, content: NoContent }), Text("x"), Comment("roc:node=9")]
				_ => crash "picture-claims: unknown independent fixture"
			}
			rendered : Dom.Rendered
			rendered = {
				markup: "",
				root_name: ElementRoot(parts.root_name),
				physical,
				containers: parts.containers.map(
					|container| {
						owner: match container.owner {
							Mount => Mount
							Element(index) => Element(index.to_u64())
						},
						role: container.role,
						children: container.children.map(U32.to_u64),
					},
				),
				logical: [],
				text_runs: [],
				scaffolds: [],
			}
			actual = PictureClaims.measurement_bytes(
				envelope,
				{ rendered: rendered },
			) ?? crash "picture-claims: independent physical fixture refused"
			if actual != vector.canonical {
				crash "picture-claims: independent picture canonical bytes differ"
			}
		}
		for vector in mount_vectors {
			if PictureClaims.fingerprint_bytes(vector.batch, {}) != Ok(vector.canonical) {
				crash "picture-claims: independent mount canonical bytes differ"
			}
		}
		{}
	}
}

