(test "Data grid — empty filter result"
  (steps
    ; Given the state established by earlier scenarios
    (mark-metrics)
    (click (role button :name "Sort by score"))
    (mark-metrics)
    (click (role button :name "Sort by score"))
    (click (role button :name "Sort by name"))
    (click (role button :name "Sort by name"))
    (click (role button :name "Sort by team"))
    (click (role button :name "Sort by id"))
    (mark-metrics)
    (click (role button :name "Next page"))
    (click (role button :name "Previous page"))
    (click (role button :name "First page"))
    (mark-metrics)
    (fill (label "Note for Node-0003") "needs review")
    (mark-metrics)
    (fill (label "Note for Node-0009") "last on page")
    (click (role button :name "Next page"))
    (click (role button :name "Previous page"))
    (mark-metrics)
    (check (label "Select Node-0002"))
    (uncheck (label "Select Node-0002"))
    (mark-metrics)
    (fill (label "Filter") "Node-119")
    (mark-metrics)
    (check (label "Select all matching rows"))
    (fill (label "Filter") "")
    (fill (label "Filter") "Node-119")
    (uncheck (label "Select all matching rows"))
    (fill (label "Filter") "Node-0007")

    ; 8. empty filter result
    (mark-metrics)
    (fill (label "Filter") "no-such-row")
    (expect-text (test-id "summary-matching") "0")
    (expect-text (test-id "summary-total") "0")
    (expect-text (test-id "summary-average") "0")
    (expect-text (test-id "summary-highest") "0")
    (expect-text (test-id "summary-lowest") "0")
    (expect-text (test-id "rows-showing") "Showing 0 of 0 rows")
    (expect-text (test-id "page-label") "Page 1 of 1")
    (expect-visible (text "No rows match the filter"))
    (expect-absent (text "Filter matches rows"))
    (expect-absent (test-id "row-name-7"))
    (expect-absent (test-id "row-team-7"))
    (expect-absent (test-id "row-score-7"))
    (expect-absent (label "Note for Node-0007"))
    (expect-absent (label "Select Node-0007"))
    (expect-checked (label "Select all matching rows") false)
    (expect-disabled (role button :name "Next page") true)
    (expect-disabled (role button :name "Previous page") true)
    (expect-metric-delta rows_removed 1)
    (expect-metric-delta rows_created 0)
    ; sorting an empty result set must not crash and must not create rows
    (mark-metrics)
    (click (role button :name "Sort by score"))
    (expect-text (test-id "sort-caption") "Sorted by score ascending")
    (expect-text (test-id "summary-matching") "0")
    (expect-visible (text "No rows match the filter"))
    (expect-absent (text "Filter matches rows"))
    (click (role button :name "Sort by score"))
    (expect-text (test-id "sort-caption") "Sorted by score descending")
    (expect-visible (text "No rows match the filter"))
    (expect-absent (text "Filter matches rows"))
    (click (role button :name "Sort by id"))
    (expect-text (test-id "sort-caption") "Sorted by id ascending")
    (expect-metric-delta rows_created 0)
    (expect-metric-delta rows_reused 0)
    ; select-all is hidden while nothing matches, so selection cannot be changed here
    (expect-text (test-id "summary-selected-all") "0")
  )
)
