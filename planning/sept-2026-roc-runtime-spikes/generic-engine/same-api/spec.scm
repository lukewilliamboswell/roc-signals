(test "mixed typed state and repeated packaged-style components"
  (steps
    (expect-visible (text "Count: 0"))
    (expect-visible (text "First: a heap-backed title from an independently defined component (open)"))
    (expect-visible (text "Second: a heap-backed title from an independently defined component (open)"))
    (mark-metrics)
    (click (role button :name "Toggle First"))
    (expect-metric-delta derived_calls_into_roc 3)
    (expect-metric-delta active_graph_records_rebuilt 0)
    (expect-metric-delta scopes_created 0)
    (expect-metric-delta scopes_disposed 0)
    (expect-visible (text "First: a heap-backed title from an independently defined component (done)"))
    (expect-visible (text "Second: a heap-backed title from an independently defined component (open)"))
    (expect-visible (text "Count: 0"))
    (click (role button :name "Increment"))
    (expect-visible (text "Count: 1"))
    (mark-metrics)
    (click (role button :name "Keep count"))
    (expect-metric-delta derived_calls_into_roc 0)
    (click (role button :name "Toggle Second"))
    (expect-visible (text "Second: a heap-backed title from an independently defined component (done)"))
    (click (role button :name "Toggle First"))
    (expect-visible (text "First: a heap-backed title from an independently defined component (open)"))
    (expect-visible (text "Second: a heap-backed title from an independently defined component (done)"))
    (click (role button :name "Toggle First"))
    (expect-visible (text "First: a heap-backed title from an independently defined component (done)"))
    (click (role button :name "Show/hide First"))
    (expect-visible (text "First hidden"))
    (click (role button :name "Show/hide First"))
    (expect-visible (text "First: a heap-backed title from an independently defined component (open)"))
    (expect-visible (text "Second: a heap-backed title from an independently defined component (done)"))
    (expect-visible (text "Count: 1"))))
