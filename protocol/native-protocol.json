{
  "schema_version": 2,
  "comment": "Single authority for the native GUI protocol tables and the shape of every task kind's request and result. Edit this file, then run `python3 scripts/generate_protocol.py` to regenerate the committed Zig, Rust, Roc, and docs artifacts. `docs/native-gui-protocol.md` documents the add-a-field and add-a-task-kind procedures.",
  "protocol_version": 12,
  "effect_version": 2,
  "timer_version": 1,
  "custom_text_field_id": 7,
  "custom_bool_field_id": 3,
  "text_fields": [
    {
      "id": 1,
      "name": "text",
      "native": false,
      "browser_op": "set_text",
      "doc": "Element text content."
    },
    {
      "id": 2,
      "name": "role",
      "native": false,
      "browser_op": "set_role",
      "doc": "Semantic role string."
    },
    {
      "id": 3,
      "name": "label",
      "native": false,
      "browser_op": "set_label",
      "doc": "Visible caption and semantic name."
    },
    {
      "id": 4,
      "name": "test_id",
      "native": false,
      "browser_op": "set_test_id",
      "doc": "Stable test selector identity."
    },
    {
      "id": 5,
      "name": "value",
      "native": false,
      "browser_op": "set_value",
      "doc": "Controlled input value."
    },
    {
      "id": 6,
      "name": "class",
      "native": false,
      "browser_op": "set_class",
      "doc": "CSS class list for browser presentation."
    },
    {
      "id": 8,
      "name": "native_style",
      "native": true,
      "roc_const": "native_style_field",
      "doc": "Versioned native presentation record; never encoded on the browser wire."
    },
    {
      "id": 9,
      "name": "native_viewport",
      "native": true,
      "roc_const": "native_viewport_field",
      "doc": "Fixed-row virtual list record `1,row_height,follow_tail`."
    },
    {
      "id": 10,
      "name": "native_drag_key",
      "native": true,
      "roc_const": "native_drag_key_field",
      "doc": "Bounded application key exposed by an internal drag source."
    },
    {
      "id": 11,
      "name": "native_window_close",
      "native": true,
      "roc_const": "native_window_close_field",
      "doc": "Window close policy: `keep-open`, `await-decision`, or `close`."
    },
    {
      "id": 12,
      "name": "native_placeholder",
      "native": true,
      "roc_const": "native_placeholder_field",
      "doc": "Static empty-field hint text shown while a controlled field is empty."
    },
    {
      "id": 13,
      "name": "native_image_source",
      "native": true,
      "roc_const": "native_image_source_field",
      "doc": "Relative image source resolved against the process-wide assets root."
    },
    {
      "id": 14,
      "name": "native_font_family",
      "native": true,
      "roc_const": "native_font_family_field",
      "doc": "Static font family joined into the element's inherited text style."
    },
    {
      "id": 15,
      "name": "native_fonts",
      "native": true,
      "roc_const": "native_fonts_field",
      "doc": "Versioned embedded-font registration declaration; registered once at startup."
    }
  ],
  "bool_fields": [
    {
      "id": 1,
      "name": "checked",
      "native": false,
      "browser_op": "set_checked",
      "doc": "Checkbox checked state."
    },
    {
      "id": 2,
      "name": "disabled",
      "native": false,
      "browser_op": "set_disabled",
      "roc_const": "disabled_field",
      "doc": "Disables input while retaining native identity."
    },
    {
      "id": 4,
      "name": "selected",
      "native": true,
      "roc_const": "selected_field",
      "doc": "Native selected presentation, independent of checkbox state."
    },
    {
      "id": 5,
      "name": "native_drop_target",
      "native": true,
      "roc_const": "native_drop_target_field",
      "doc": "Marks an internal drop target that must bind a string-detail drop event."
    },
    {
      "id": 6,
      "name": "native_read_only",
      "native": true,
      "roc_const": "native_read_only_field",
      "doc": "Refuses user edits and edit history while the control stays available at full contrast and in tab order."
    }
  ],
  "task_kinds": [
    {
      "id": 0,
      "name": "external",
      "doc": "App-declared external task; the only route the browser host accepts.",
      "request": [],
      "result": []
    },
    {
      "id": 1,
      "name": "choose_file",
      "doc": "Native file chooser dialog.",
      "request": [],
      "result": [
        {
          "name": "choice",
          "type": "tagged",
          "variants": [
            {
              "tag": "chosen",
              "fields": [
                {
                  "name": "path",
                  "type": "path",
                  "doc": "The chosen absolute path."
                }
              ]
            },
            {
              "tag": "canceled",
              "fields": []
            }
          ],
          "doc": "The dialog's outcome."
        }
      ],
      "fixture": "resolve-file-choice"
    },
    {
      "id": 2,
      "name": "choose_directory",
      "doc": "Native directory chooser dialog.",
      "request": [],
      "result": [
        {
          "name": "choice",
          "type": "tagged",
          "variants": [
            {
              "tag": "chosen",
              "fields": [
                {
                  "name": "path",
                  "type": "path",
                  "doc": "The chosen absolute path."
                }
              ]
            },
            {
              "tag": "canceled",
              "fields": []
            }
          ],
          "doc": "The dialog's outcome."
        }
      ],
      "fixture": "resolve-file-choice"
    },
    {
      "id": 3,
      "name": "choose_save_path",
      "doc": "Native save-path chooser with location kind, directory, and suggested name.",
      "request": [
        {
          "name": "directory_kind",
          "type": "enum",
          "values": [
            "home",
            "at"
          ],
          "doc": "Where the dialog starts: the profile root, or an explicit directory."
        },
        {
          "name": "directory",
          "type": "text",
          "max_bytes": 4096,
          "doc": "The explicit directory for `at`; empty for `home`."
        },
        {
          "name": "suggested_name",
          "type": "text",
          "max_bytes": 255,
          "non_empty": true,
          "doc": "The proposed file name."
        }
      ],
      "result": [
        {
          "name": "choice",
          "type": "tagged",
          "variants": [
            {
              "tag": "chosen",
              "fields": [
                {
                  "name": "path",
                  "type": "path",
                  "doc": "The chosen absolute path."
                }
              ]
            },
            {
              "tag": "canceled",
              "fields": []
            }
          ],
          "doc": "The dialog's outcome."
        }
      ],
      "fixture": "resolve-file-choice"
    },
    {
      "id": 4,
      "name": "read_text",
      "doc": "Bounded UTF-8 text read of one absolute path.",
      "request": [
        {
          "name": "path",
          "type": "path",
          "doc": "Absolute file path."
        }
      ],
      "result": [
        {
          "name": "path",
          "type": "path",
          "doc": "The path that was read."
        },
        {
          "name": "text",
          "type": "text",
          "max_bytes": 1048576,
          "doc": "Complete UTF-8 contents."
        }
      ],
      "fixture": "resolve-file-read"
    },
    {
      "id": 5,
      "name": "write_text",
      "doc": "Atomic bounded UTF-8 text write of one absolute path.",
      "request": [
        {
          "name": "path",
          "type": "path",
          "doc": "Absolute destination path."
        },
        {
          "name": "text",
          "type": "text",
          "max_bytes": 1048576,
          "doc": "Complete UTF-8 contents to write."
        }
      ],
      "result": [
        {
          "name": "path",
          "type": "path",
          "doc": "The path that was written."
        },
        {
          "name": "bytes",
          "type": "u64",
          "max_value": 1048576,
          "doc": "Bytes written."
        }
      ],
      "fixture": "resolve-file-write"
    },
    {
      "id": 6,
      "name": "scan_directory",
      "doc": "Bounded recursive directory metadata scan.",
      "request": [
        {
          "name": "root",
          "type": "path",
          "doc": "Absolute directory to walk."
        }
      ],
      "result": [
        {
          "name": "root",
          "type": "path",
          "doc": "The scanned root."
        },
        {
          "name": "entries",
          "type": "list",
          "max_items": 10000,
          "of": [
            {
              "name": "path",
              "type": "path",
              "doc": "Entry path."
            },
            {
              "name": "kind",
              "type": "enum",
              "values": [
                "file",
                "directory",
                "symbolic-link",
                "other"
              ],
              "doc": "Entry kind."
            },
            {
              "name": "bytes",
              "type": "u64",
              "doc": "Regular-file size."
            }
          ],
          "doc": "Every entry found, depth first."
        }
      ]
    },
    {
      "id": 7,
      "name": "list_directory",
      "doc": "Bounded direct-children directory listing.",
      "request": [
        {
          "name": "path",
          "type": "path",
          "doc": "Absolute directory to list."
        }
      ],
      "result": [
        {
          "name": "path",
          "type": "path",
          "doc": "The listed directory."
        },
        {
          "name": "entries",
          "type": "list",
          "max_items": 10000,
          "spelling": [
            "kind",
            "path",
            "bytes"
          ],
          "of": [
            {
              "name": "path",
              "type": "path",
              "doc": "Entry path."
            },
            {
              "name": "kind",
              "type": "enum",
              "values": [
                "file",
                "directory",
                "symbolic-link",
                "other"
              ],
              "doc": "Entry kind."
            },
            {
              "name": "bytes",
              "type": "u64",
              "doc": "Regular-file size."
            }
          ],
          "doc": "Direct children only."
        }
      ],
      "fixture": "resolve-file-directory",
      "rules": [
        "directory_path_budget"
      ]
    },
    {
      "id": 8,
      "name": "open_path",
      "doc": "Hand one regular file to its associated application.",
      "request": [
        {
          "name": "path",
          "type": "path",
          "doc": "Absolute file to open."
        }
      ],
      "result": [
        {
          "name": "path",
          "type": "path",
          "doc": "The path handed to the launcher."
        }
      ],
      "fixture": "resolve-file-open"
    },
    {
      "id": 9,
      "name": "read_preview",
      "doc": "Bounded UTF-8 prefix read with an explicit truncation marker.",
      "request": [
        {
          "name": "path",
          "type": "path",
          "doc": "Absolute file path."
        }
      ],
      "result": [
        {
          "name": "path",
          "type": "path",
          "doc": "The path that was read."
        },
        {
          "name": "text",
          "type": "text",
          "max_bytes": 65536,
          "doc": "UTF-8 prefix of the file."
        },
        {
          "name": "truncated",
          "type": "bool",
          "doc": "Whether bytes were omitted."
        }
      ],
      "fixture": "resolve-file-preview"
    },
    {
      "id": 10,
      "name": "read_log",
      "doc": "Cursor-driven bounded log chunk read with rotation detection.",
      "request": [
        {
          "name": "path",
          "type": "path",
          "doc": "Absolute log path."
        },
        {
          "name": "position",
          "type": "enum",
          "values": [
            "start",
            "end",
            "after"
          ],
          "doc": "Where to read from."
        },
        {
          "name": "device",
          "type": "u64",
          "doc": "Cursor device; zero unless `after`."
        },
        {
          "name": "inode",
          "type": "u64",
          "doc": "Cursor inode; zero unless `after`."
        },
        {
          "name": "offset",
          "type": "u64",
          "doc": "Cursor byte offset; zero unless `after`."
        }
      ],
      "result": [
        {
          "name": "path",
          "type": "path",
          "doc": "The log that was read."
        },
        {
          "name": "text",
          "type": "text",
          "max_bytes": 65536,
          "doc": "New bytes since the cursor."
        },
        {
          "name": "device",
          "type": "u64",
          "doc": "Cursor device after the read."
        },
        {
          "name": "inode",
          "type": "u64",
          "doc": "Cursor inode after the read."
        },
        {
          "name": "offset",
          "type": "u64",
          "doc": "Cursor byte offset after the read."
        },
        {
          "name": "change",
          "type": "enum",
          "values": [
            "initial",
            "continued",
            "rotated",
            "truncated"
          ],
          "doc": "How the file changed since the cursor."
        },
        {
          "name": "state",
          "type": "enum",
          "values": [
            "more",
            "at-end",
            "partial-utf8"
          ],
          "doc": "Whether more is pending."
        }
      ],
      "fixture": "resolve-file-log",
      "request_rules": [
        "log_cursor"
      ]
    },
    {
      "id": 11,
      "name": "verify_assets",
      "doc": "Hash a bounded manifest of relative assets against expected SHA-256 digests.",
      "request": [
        {
          "name": "entries",
          "type": "list",
          "min_items": 1,
          "max_items": 256,
          "of": [
            {
              "name": "name",
              "type": "text",
              "max_bytes": 1024,
              "non_empty": true,
              "doc": "Relative asset name."
            },
            {
              "name": "digest",
              "type": "hex_sha256",
              "doc": "Expected lowercase hex SHA-256."
            }
          ],
          "doc": "The manifest to verify."
        }
      ],
      "result": [
        {
          "name": "entries",
          "type": "list",
          "min_items": 1,
          "max_items": 256,
          "spelling": [
            "status",
            "name"
          ],
          "of": [
            {
              "name": "name",
              "type": "text",
              "max_bytes": 1024,
              "non_empty": true,
              "doc": "Relative asset name."
            },
            {
              "name": "status",
              "type": "enum",
              "values": [
                "ok",
                "missing",
                "mismatch"
              ],
              "doc": "Verification outcome."
            }
          ],
          "doc": "One outcome per manifest entry."
        }
      ],
      "fixture": "resolve-file-assets",
      "request_rules": [
        "assets_manifest"
      ]
    }
  ],
  "task_error": {
    "comment": "The error every non-external task kind can settle with; `reject-file` is its fixture.",
    "fixture": "reject-file",
    "rules": [
      "canceled_empty_detail"
    ],
    "fields": [
      {
        "name": "kind",
        "type": "enum",
        "values": [
          "canceled",
          "not-found",
          "permission-denied",
          "invalid-utf8",
          "invalid-path",
          "resource-limit",
          "io",
          "unavailable"
        ],
        "doc": "Typed failure kind (the protocol reference calls this the error code)."
      },
      {
        "name": "detail",
        "type": "text",
        "max_bytes": 4096,
        "doc": "Diagnostic detail; empty for `canceled`."
      }
    ]
  },
  "raw_node": {
    "comment": "Field order is ABI: Zig writes and Rust reads this extern record byte-for-byte. Types: u64, usize, slice (pointer+length borrowed UTF-8), style (18 u32 presentation record), viewport (2 u32 record).",
    "fields": [
      {
        "name": "id",
        "type": "u64",
        "doc": "Committed element id."
      },
      {
        "name": "active",
        "type": "u64",
        "doc": "Nonzero while the element is mounted."
      },
      {
        "name": "parent",
        "type": "u64",
        "doc": "Committed parent element id, zero for the root."
      },
      {
        "name": "tag",
        "type": "slice",
        "doc": "Element tag string."
      },
      {
        "name": "text",
        "type": "slice",
        "doc": "Text content (text field 1)."
      },
      {
        "name": "value",
        "type": "slice",
        "doc": "Controlled input value (text field 5)."
      },
      {
        "name": "label",
        "type": "slice",
        "doc": "Caption and semantic name (text field 3)."
      },
      {
        "name": "role",
        "type": "slice",
        "doc": "Semantic role (text field 2)."
      },
      {
        "name": "test_id",
        "type": "slice",
        "doc": "Test selector identity (text field 4)."
      },
      {
        "name": "class",
        "type": "slice",
        "doc": "Class list (text field 6)."
      },
      {
        "name": "placeholder",
        "type": "slice",
        "doc": "Empty-field hint (text field 12)."
      },
      {
        "name": "image_source",
        "type": "slice",
        "doc": "Relative image source (text field 13)."
      },
      {
        "name": "font_family",
        "type": "slice",
        "doc": "Inherited font family (text field 14)."
      },
      {
        "name": "fonts",
        "type": "slice",
        "doc": "Embedded font declaration (text field 15)."
      },
      {
        "name": "child_count",
        "type": "usize",
        "doc": "Committed child count; children are read through signals_child_at."
      },
      {
        "name": "click",
        "type": "u64",
        "doc": "Bound click event id, zero when unbound."
      },
      {
        "name": "input",
        "type": "u64",
        "doc": "Bound input event id, zero when unbound."
      },
      {
        "name": "check",
        "type": "u64",
        "doc": "Bound check event id, zero when unbound."
      },
      {
        "name": "checked",
        "type": "u64",
        "doc": "Checked state word (bool field 1)."
      },
      {
        "name": "disabled",
        "type": "u64",
        "doc": "Disabled state word (bool field 2)."
      },
      {
        "name": "selected",
        "type": "u64",
        "doc": "Selected presentation word (bool field 4)."
      },
      {
        "name": "read_only",
        "type": "u64",
        "doc": "Read-only state word (bool field 6)."
      },
      {
        "name": "style_present",
        "type": "u64",
        "doc": "Nonzero when the style record is populated (text field 8)."
      },
      {
        "name": "style",
        "type": "style",
        "doc": "Validated native presentation record (text field 8)."
      },
      {
        "name": "viewport",
        "type": "viewport",
        "doc": "Validated virtual-list record (text field 9), zeroed when absent."
      },
      {
        "name": "lifetime",
        "type": "u64",
        "doc": "Checked lifetime counter advanced on descriptor retirement."
      },
      {
        "name": "drag_key",
        "type": "slice",
        "doc": "Internal drag source key (text field 10)."
      },
      {
        "name": "drop",
        "type": "u64",
        "doc": "Bound drop event id for an active drop target, zero otherwise (bool field 5)."
      },
      {
        "name": "close_requested",
        "type": "u64",
        "doc": "Bound close-requested event id for a registered window (text field 11)."
      },
      {
        "name": "close_policy",
        "type": "u64",
        "doc": "Close-decision word: 0 unregistered, KeepOpen=1, AwaitDecision=2, Close=3."
      }
    ]
  },
  "version_history": [
    {
      "version": 12,
      "summary": "Adds the `native_read_only` boolean field and its node word: a control that refuses edits while staying readable and keyboard reachable, distinct from disabled."
    },
    {
      "version": 11,
      "summary": "Adds `signals_document_title`, the host read of the window identity decided by the shared engine's `SetDocumentTitle` command."
    },
    {
      "version": 10,
      "summary": "Extends the presentation record to style version 2 with hover and active background slots (18 u32 style record); style version 1 records are no longer accepted."
    },
    {
      "version": 9,
      "summary": "Adds the explicit image-source text slot together with the font-family and embedded-font declaration slots to the node layout."
    },
    {
      "version": 8,
      "summary": "Adds the placeholder text slot to the node layout."
    },
    {
      "version": 7,
      "summary": "Adds explicit event-detail dispatch to `signals_dispatch`."
    },
    {
      "version": 6,
      "summary": "Adds the close-request event ID and close-decision word to the node layout."
    }
  ]
}
