(test "Attribute presence distinguishes empty text across row histories"
  (steps
    (expect-attr (test-id "attribute-plain") "alt" "")
    (expect-attr (test-id "attribute-row-a") "aria-label" "")
    (expect-no-attr (test-id "attribute-plain") "title")
    (expect-no-attr (test-id "attribute-row-a") "title")
    (mark-metrics)
    (click (role button :name "Empty attribute"))
    (expect-attr (test-id "attribute-plain") "title" "")
    (expect-attr (test-id "attribute-row-a") "title" "")
    (expect-attr (test-id "attribute-row-b") "title" "")
    (expect-metric-delta patches_emitted 3)
    (mark-metrics)
    (click (role button :name "Empty attribute"))
    (expect-metric-delta patches_emitted 0)
    (click (role button :name "Text attribute"))
    (expect-attr (test-id "attribute-plain") "title" "named")
    (expect-attr (test-id "attribute-row-a") "title" "named")
    (click (role button :name "Reverse attribute rows"))
    (expect-attr (test-id "attribute-row-a") "title" "named")
    (click (role button :name "Remove attribute row"))
    (expect-absent (test-id "attribute-row-a"))
    (click (role button :name "Absent attribute"))
    (expect-no-attr (test-id "attribute-plain") "title")
    (expect-no-attr (test-id "attribute-row-b") "title")
    (click (role button :name "Restore attribute rows"))
    (expect-no-attr (test-id "attribute-row-a") "title")
    (expect-attr (test-id "attribute-row-a") "aria-label" "")
    (click (role button :name "Empty attribute"))
    (expect-attr (test-id "attribute-row-a") "title" "")))
