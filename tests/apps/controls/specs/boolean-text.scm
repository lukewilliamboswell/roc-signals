(test "Boolean attribute text keeps until-found and other present keywords"
  (setup (initial-location "/#rendering"))
  (steps
    (expect-attr (test-id "findable") "hidden" "until-found")
    (click (role button :name "Show findable"))
    (expect-no-attr (test-id "findable") "hidden")
    (click (role button :name "Hide findable"))
    (expect-attr (test-id "findable") "hidden" "")
    (click (role button :name "Findable until found"))
    (expect-attr (test-id "findable") "hidden" "until-found")
    (expect-attr (test-id "boolean-static") "readonly" "named")
    (expect-attr (test-id "boolean-static") "required" "named")
    (expect-attr (test-id "boolean-static") "multiple" "named")
    (expect-attr (test-id "boolean-static") "selected" "named")
    (expect-attr (test-id "boolean-static") "open" "named")
    (expect-attr (test-id "boolean-row") "readonly" "named")
    (expect-attr (test-id "boolean-row") "required" "named")
    (expect-attr (test-id "boolean-row") "multiple" "named")
    (expect-attr (test-id "boolean-row") "selected" "named")
    (expect-attr (test-id "boolean-row") "open" "named")))
