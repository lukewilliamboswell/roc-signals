(test "Effective input types retain raw spelling and commit on blur"
  (setup (initial-location "/#effective-types"))
  (steps
    (expect-no-attr (label "Absent") "type")
    (fill (label "Absent") "typed-Absent")
    (expect-value (label "Absent") "typed-Absent")
    (expect-text (test-id "commit-Absent") ":0")
    (blur (label "Absent"))
    (expect-text (test-id "commit-Absent") "typed-Absent:1")
    (expect-attr (label "Empty") "type" "")
    (fill (label "Empty") "typed-Empty")
    (expect-value (label "Empty") "typed-Empty")
    (expect-text (test-id "commit-Empty") ":0")
    (blur (label "Empty"))
    (expect-text (test-id "commit-Empty") "typed-Empty:1")
    (expect-attr (label "Mixed") "type" "Text")
    (fill (label "Mixed") "typed-Mixed")
    (expect-value (label "Mixed") "typed-Mixed")
    (expect-text (test-id "commit-Mixed") ":0")
    (blur (label "Mixed"))
    (expect-text (test-id "commit-Mixed") "typed-Mixed:1")
    (expect-attr (label "Invalid") "type" "txet")
    (fill (label "Invalid") "typed-Invalid")
    (expect-value (label "Invalid") "typed-Invalid")
    (expect-text (test-id "commit-Invalid") ":0")
    (blur (label "Invalid"))
    (expect-text (test-id "commit-Invalid") "typed-Invalid:1")
    (expect-attr (label "Padded") "type" " text ")
    (fill (label "Padded") "typed-Padded")
    (expect-value (label "Padded") "typed-Padded")
    (expect-text (test-id "commit-Padded") ":0")
    (blur (label "Padded"))
    (expect-text (test-id "commit-Padded") "typed-Padded:1")
    (expect-attr (label "NonASCII") "type" "TÉXT")
    (fill (label "NonASCII") "typed-NonASCII")
    (expect-value (label "NonASCII") "typed-NonASCII")
    (expect-text (test-id "commit-NonASCII") ":0")
    (blur (label "NonASCII"))
    (expect-text (test-id "commit-NonASCII") "typed-NonASCII:1")))
