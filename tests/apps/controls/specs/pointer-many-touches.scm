(test "Pointers — the driver supports sixteen simultaneous touch contacts"
  (setup (initial-location "/#pointer"))
  (steps
    (mark-metrics)
    (pointer-down (test-id "pointer-capture") :pointer touch :id 2)
    (pointer-down (test-id "pointer-capture") :pointer touch :id 3)
    (pointer-down (test-id "pointer-capture") :pointer touch :id 4)
    (pointer-down (test-id "pointer-capture") :pointer touch :id 5)
    (pointer-down (test-id "pointer-capture") :pointer touch :id 6)
    (pointer-down (test-id "pointer-capture") :pointer touch :id 7)
    (pointer-down (test-id "pointer-capture") :pointer touch :id 8)
    (pointer-down (test-id "pointer-capture") :pointer touch :id 9)
    (pointer-down (test-id "pointer-capture") :pointer touch :id 10)
    (pointer-down (test-id "pointer-capture") :pointer touch :id 11)
    (pointer-down (test-id "pointer-capture") :pointer touch :id 12)
    (pointer-down (test-id "pointer-capture") :pointer touch :id 13)
    (pointer-down (test-id "pointer-capture") :pointer touch :id 14)
    (pointer-down (test-id "pointer-capture") :pointer touch :id 15)
    (pointer-down (test-id "pointer-capture") :pointer touch :id 16)
    (pointer-down (test-id "pointer-capture") :pointer touch :id 17)
    (pointer-up (test-id "pointer-capture") :id 2)
    (pointer-up (test-id "pointer-capture") :id 3)
    (pointer-up (test-id "pointer-capture") :id 4)
    (pointer-up (test-id "pointer-capture") :id 5)
    (pointer-up (test-id "pointer-capture") :id 6)
    (pointer-up (test-id "pointer-capture") :id 7)
    (pointer-up (test-id "pointer-capture") :id 8)
    (pointer-up (test-id "pointer-capture") :id 9)
    (pointer-up (test-id "pointer-capture") :id 10)
    (pointer-up (test-id "pointer-capture") :id 11)
    (pointer-up (test-id "pointer-capture") :id 12)
    (pointer-up (test-id "pointer-capture") :id 13)
    (pointer-up (test-id "pointer-capture") :id 14)
    (pointer-up (test-id "pointer-capture") :id 15)
    (pointer-up (test-id "pointer-capture") :id 16)
    (pointer-up (test-id "pointer-capture") :id 17)
    (expect-metric-delta dirty_source_roots 32)))
