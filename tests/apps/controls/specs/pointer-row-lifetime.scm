(test "Pointers — moving or removing the pressed row ends without a click"
  (setup (initial-location "/#pointer"))
  (steps
    (click (role button :name "On up move"))
    (pointer-down (test-id "pointer-grip-a"))
    (pointer-up (test-id "pointer-outside"))
    (expect-text (test-id "pointer-rows") "bca")
    (expect-text (test-id "pointer-log") "row-down:mouse:1:grip:a:5000:5000|row-up:mouse:0:outside|parent-mouseup")
    (click (role button :name "Reset pointer rows"))
    (click (role button :name "On up remove"))
    (pointer-down (test-id "pointer-grip-a"))
    (pointer-up (test-id "pointer-outside"))
    (expect-text (test-id "pointer-rows") "bc")
    (expect-text (test-id "pointer-log") "row-down:mouse:1:grip:a:5000:5000|row-up:mouse:0:outside|parent-mouseup")
    (click (role button :name "Reset pointer rows"))
    (click (role button :name "On up clear"))
    (pointer-down (test-id "pointer-grip-a"))
    (pointer-up (test-id "pointer-outside"))
    (expect-text (test-id "pointer-rows") "")
    (expect-text (test-id "pointer-log") "row-down:mouse:1:grip:a:5000:5000|row-up:mouse:0:outside|parent-mouseup")
    (click (role button :name "Reset pointer rows"))
    (click (role button :name "On up remove parent"))
    (pointer-down (test-id "pointer-grip-a"))
    (pointer-up (test-id "pointer-outside"))
    (expect-absent (test-id "pointer-rows"))
    (expect-text (test-id "pointer-log") "row-down:mouse:1:grip:a:5000:5000|row-up:mouse:0:outside|parent-mouseup")))
