(test "Raw input types use ASCII case without changing attribute text"
  (setup
    (initial-location "/#raw-input")
    (file "mixed.txt" "text/plain" "content"))
  (steps
    (expect-attr (label "Mixed checkbox") "type" "CHECKBOX")
    (expect-value (label "Mixed checkbox") "on")
    (check (label "Mixed checkbox"))
    (expect-checked (label "Mixed checkbox") true)
    (expect-text (test-id "mixed-checked") "true")
    (click (label "Mixed checkbox"))
    (expect-checked (label "Mixed checkbox") false)
    (expect-text (test-id "mixed-checked") "false")
    (expect-attr (label "Mixed first") "type" "Radio")
    (expect-attr (label "Mixed second") "type" "RADIO")
    (check (label "Mixed first"))
    (expect-checked (label "Mixed first") true)
    (expect-text (test-id "mixed-radio") "first")
    (click (label "Mixed second"))
    (expect-checked (label "Mixed second") true)
    (expect-checked (label "Mixed first") false)
    (expect-text (test-id "mixed-radio") "second")
    (change (label "Mixed first") "first")
    (expect-checked (label "Mixed first") true)
    (expect-checked (label "Mixed second") false)
    (expect-attr (label "Mixed text") "type" "Text")
    (fill (label "Mixed text") "typed")
    (expect-value (label "Mixed text") "typed")
    (expect-text (test-id "mixed-text") "typed")
    (expect-attr (label "Mixed file") "type" "FILE")
    (choose-files (label "Mixed file") "mixed.txt")
    (expect-text (test-id "mixed-files") "mixed.txt")
    (expect-files 0)))
