(test "A selected reference changes owners in one turn and empty names name nothing"
  (steps
    (click (role button :name "Use selected reference"))
    (click (role button :name "Focus current row"))
    (expect-focused (label "Row a"))
    (mark-metrics)
    (click (role button :name "Select row b"))
    (expect-metric-delta patches_emitted 0)
    (expect-metric-delta rows_created 0)
    (expect-metric-delta rows_removed 0)
    (click (role button :name "Focus current row"))
    (expect-focused (label "Row b"))
    (click (role button :name "Clear reference names"))
    (mark-metrics)
    (click (role button :name "Focus current row"))
    (expect-focused (role button :name "Focus current row"))
    (click (role button :name "Focus empty name"))
    (expect-focused (role button :name "Focus empty name"))
    (expect-metric-delta effects_stale 2)))
