(test "Row properties keep control state and prune equal values"
  (steps
    (expect-checked (label "Property check a") false)
    (expect-checked (label "Property check b") true)
    (expect-value (label "Property option a") "a")
    (expect-value (label "Property option b") "b")
    (mark-metrics)
    (click (role button :name "Set row checks"))
    (expect-checked (label "Property check a") true)
    (expect-checked (label "Property check b") true)
    (expect-metric-delta set_checked 1)
    (expect-metric-delta rows_created 0)
    (mark-metrics)
    (click (role button :name "Touch row metadata"))
    (expect-metric-delta patches_emitted 0)
    (expect-metric-delta set_value 0)
    (expect-metric-delta set_checked 0)
    (select-option (label "Property option a") "other")
    (expect-value (label "Property option a") "other")
    (expect-value (label "Property option b") "b")
    (uncheck (label "Property check b"))
    (expect-checked (label "Property check b") false)
    (expect-checked (label "Property check a") true)
    (expect-attr (test-id "ordinary-progress") "value" "0.5")
    (expect-attr (test-id "ordinary-custom-value") "value" "attribute only")))
