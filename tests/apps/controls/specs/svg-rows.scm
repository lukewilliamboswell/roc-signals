(test "SVG attributes retain their case in static nodes and keyed rows"
  (setup (initial-location "/#rendering"))
  (steps
    (expect-attr (test-id "plain-svg") "viewBox" "0 0 20 20")
    (expect-element (test-id "plain-svg") svg "svg")
    (expect-attr (test-id "plain-svg-static-gradient") "gradientUnits" "userSpaceOnUse")
    (expect-element (test-id "plain-svg-static-gradient") svg "linearGradient")
    (expect-attr (test-id "plain-svg-static-path") "pathLength" "10")
    (expect-element (test-id "plain-svg-static-path") svg "path")
    (expect-attr (test-id "plain-svg-fixed-a") "pathLength" "10")
    (expect-element (test-id "plain-svg-fixed-a") svg "path")
    (expect-attr (test-id "plain-svg-length-a") "pathLength" "10")
    (expect-element (test-id "plain-svg-length-a") svg "path")
    (click (role button :name "Change SVG length"))
    (expect-attr (test-id "plain-svg-length-a") "pathLength" "20")
    (expect-element (test-id "plain-svg-length-a") svg "path")
    (click (role button :name "Reverse SVG rows"))
    (expect-attr (test-id "plain-svg-length-a") "pathLength" "20")
    (expect-element (test-id "plain-svg-length-a") svg "path")
    (click (role button :name "Remove SVG row"))
    (expect-absent (test-id "plain-svg-length-a"))
    (click (role button :name "Restore SVG rows"))
    (expect-attr (test-id "plain-svg-length-a") "pathLength" "20")
    (expect-element (test-id "plain-svg-length-a") svg "path")
    (click (role button :name "Animate SVG mount"))
    (expect-attr (test-id "animated-svg") "viewBox" "0 0 20 20")
    (expect-element (test-id "animated-svg") svg "svg")
    (expect-attr (test-id "animated-svg-static-gradient") "gradientUnits" "userSpaceOnUse")
    (expect-element (test-id "animated-svg-static-gradient") svg "linearGradient")
    (expect-attr (test-id "animated-svg-fixed-a") "pathLength" "10")
    (expect-element (test-id "animated-svg-fixed-a") svg "path")
    (expect-attr (test-id "animated-svg-length-a") "pathLength" "20")
    (expect-element (test-id "animated-svg-length-a") svg "path")))
