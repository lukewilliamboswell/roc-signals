(test "Top layer — each step grants user activation exactly as the activation table says"
  (setup
    (initial-location "/#top-layer")
    (file "a.txt" "text/plain" "a"))
  (steps
    ; A prevented cancel holds once per activation. Each round opens the
    ; dialog in a new document, spends the opening click on one Escape and
    ; performs the steps it names: the next Escape is held (modal) when they
    ; granted activation and closes the dialog (hidden) when they did not.
    ; Escape spelt as a key, and as dismiss, is the last round.
    ; click: grants it
    (click (role button :name "Open prevented"))
    (dismiss)
    (expect-shown (label "Prevented") modal)
    (click (role button :name "Prevented inside"))
    (dismiss)
    (expect-shown (label "Prevented") modal)
    ; click on a disabled control: does not grant it
    (navigate "/?round=2#top-layer")
    (click (role button :name "Open prevented"))
    (dismiss)
    (expect-shown (label "Prevented") modal)
    (click (role button :name "Prevented disabled"))
    (dismiss)
    (expect-shown (label "Prevented") hidden)
    ; real-click: grants it
    (navigate "/?round=3#top-layer")
    (click (role button :name "Open prevented"))
    (dismiss)
    (expect-shown (label "Prevented") modal)
    (real-click (role button :name "Prevented inside"))
    (dismiss)
    (expect-shown (label "Prevented") modal)
    ; check: grants it
    (navigate "/?round=4#top-layer")
    (click (role button :name "Open prevented"))
    (dismiss)
    (expect-shown (label "Prevented") modal)
    (check (label "Prevented box"))
    (dismiss)
    (expect-shown (label "Prevented") modal)
    ; check of a checked box: does not grant it
    (navigate "/?round=5#top-layer")
    (click (role button :name "Open prevented"))
    (check (label "Prevented box"))
    (click (role button :name "Close prevented"))
    (expect-shown (label "Prevented") hidden)
    (click (role button :name "Open prevented"))
    (dismiss)
    (expect-shown (label "Prevented") modal)
    (check (label "Prevented box"))
    (dismiss)
    (expect-shown (label "Prevented") hidden)
    ; uncheck: grants it
    (navigate "/?round=6#top-layer")
    (click (role button :name "Open prevented"))
    (check (label "Prevented box"))
    (click (role button :name "Close prevented"))
    (expect-shown (label "Prevented") hidden)
    (click (role button :name "Open prevented"))
    (dismiss)
    (expect-shown (label "Prevented") modal)
    (uncheck (label "Prevented box"))
    (dismiss)
    (expect-shown (label "Prevented") modal)
    ; uncheck of an unchecked box: does not grant it
    (navigate "/?round=7#top-layer")
    (click (role button :name "Open prevented"))
    (dismiss)
    (expect-shown (label "Prevented") modal)
    (uncheck (label "Prevented box"))
    (dismiss)
    (expect-shown (label "Prevented") hidden)
    ; fill: grants it
    (navigate "/?round=8#top-layer")
    (click (role button :name "Open prevented"))
    (dismiss)
    (expect-shown (label "Prevented") modal)
    (fill (label "Prevented text") "typed")
    (dismiss)
    (expect-shown (label "Prevented") modal)
    ; fill with nothing: does not grant it
    (navigate "/?round=9#top-layer")
    (click (role button :name "Open prevented"))
    (dismiss)
    (expect-shown (label "Prevented") modal)
    (fill (label "Prevented text") "")
    (dismiss)
    (expect-shown (label "Prevented") hidden)
    ; press: grants it
    (navigate "/?round=10#top-layer")
    (click (role button :name "Open prevented"))
    (dismiss)
    (expect-shown (label "Prevented") modal)
    (press "F2")
    (dismiss)
    (expect-shown (label "Prevented") modal)
    ; pointer-down of a mouse grants it (held); its pointer-up: does not grant it
    (navigate "/?round=11#top-layer")
    (click (role button :name "Open prevented"))
    (dismiss)
    (expect-shown (label "Prevented") modal)
    (pointer-down (test-id "prevented-zone") :pointer mouse)
    (dismiss)
    (expect-shown (label "Prevented") modal)
    (pointer-up (test-id "prevented-zone"))
    (dismiss)
    (expect-shown (label "Prevented") hidden)
    ; pointer-down of a pen grants it (held); its pointer-up: does not grant it
    (navigate "/?round=12#top-layer")
    (click (role button :name "Open prevented"))
    (dismiss)
    (expect-shown (label "Prevented") modal)
    (pointer-down (test-id "prevented-zone") :pointer pen :id 2)
    (dismiss)
    (expect-shown (label "Prevented") modal)
    (pointer-up (test-id "prevented-zone") :id 2)
    (dismiss)
    (expect-shown (label "Prevented") hidden)
    ; pointer-down, pointer-move and pointer-cancel of a touch: does not grant it
    (navigate "/?round=13#top-layer")
    (click (role button :name "Open prevented"))
    (dismiss)
    (expect-shown (label "Prevented") modal)
    (pointer-down (test-id "prevented-zone") :pointer touch :id 2)
    (pointer-move (test-id "prevented-zone") :at 80 50 :id 2)
    (pointer-cancel :id 2)
    (dismiss)
    (expect-shown (label "Prevented") hidden)
    ; pointer-up of a touch: grants it
    (navigate "/?round=14#top-layer")
    (click (role button :name "Open prevented"))
    (dismiss)
    (expect-shown (label "Prevented") modal)
    (pointer-down (test-id "prevented-zone") :pointer touch :id 2)
    (pointer-up (test-id "prevented-zone") :id 2)
    (dismiss)
    (expect-shown (label "Prevented") modal)
    ; pointer-move of a mouse: does not grant it
    (navigate "/?round=15#top-layer")
    (click (role button :name "Open prevented"))
    (dismiss)
    (expect-shown (label "Prevented") modal)
    (pointer-move (test-id "prevented-zone"))
    (dismiss)
    (expect-shown (label "Prevented") hidden)
    ; select-option: does not grant it
    (navigate "/?round=16#top-layer")
    (click (role button :name "Open prevented"))
    (dismiss)
    (expect-shown (label "Prevented") modal)
    (select-option (label "Prevented choice") "two")
    (dismiss)
    (expect-shown (label "Prevented") hidden)
    ; submit: does not grant it
    (navigate "/?round=17#top-layer")
    (click (role button :name "Open prevented"))
    (dismiss)
    (expect-shown (label "Prevented") modal)
    (submit (label "Prevented form"))
    (dismiss)
    (expect-shown (label "Prevented") hidden)
    ; focus: does not grant it
    (navigate "/?round=18#top-layer")
    (click (role button :name "Open prevented"))
    (dismiss)
    (expect-shown (label "Prevented") modal)
    (focus (label "Prevented text"))
    (dismiss)
    (expect-shown (label "Prevented") hidden)
    ; blur: does not grant it
    (navigate "/?round=19#top-layer")
    (click (role button :name "Open prevented"))
    (dismiss)
    (expect-shown (label "Prevented") modal)
    (blur (role button :name "Prevented inside"))
    (dismiss)
    (expect-shown (label "Prevented") hidden)
    ; change: does not grant it
    (navigate "/?round=20#top-layer")
    (click (role button :name "Open prevented"))
    (dismiss)
    (expect-shown (label "Prevented") modal)
    (change (label "Prevented text") "changed")
    (dismiss)
    (expect-shown (label "Prevented") hidden)
    ; paste-text: does not grant it
    (navigate "/?round=21#top-layer")
    (click (role button :name "Open prevented"))
    (dismiss)
    (expect-shown (label "Prevented") modal)
    (paste-text (label "Prevented paste") "pasted")
    (dismiss)
    (expect-shown (label "Prevented") hidden)
    ; choose-files: does not grant it
    (navigate "/?round=22#top-layer")
    (click (role button :name "Open prevented"))
    (dismiss)
    (expect-shown (label "Prevented") modal)
    (choose-files (label "Prevented file") "a.txt")
    (dismiss)
    (expect-shown (label "Prevented") hidden)
    ; drop-files: does not grant it
    (navigate "/?round=23#top-layer")
    (click (role button :name "Open prevented"))
    (dismiss)
    (expect-shown (label "Prevented") modal)
    (drop-files (label "Prevented drop") "a.txt")
    (dismiss)
    (expect-shown (label "Prevented") hidden)
    ; paste-files: does not grant it
    (navigate "/?round=24#top-layer")
    (click (role button :name "Open prevented"))
    (dismiss)
    (expect-shown (label "Prevented") modal)
    (paste-files (label "Prevented drop") "a.txt")
    (dismiss)
    (expect-shown (label "Prevented") hidden)
    ; steps that are not user input: does not grant it
    (navigate "/?round=25#top-layer")
    (click (role button :name "Open prevented"))
    (dismiss)
    (expect-shown (label "Prevented") modal)
    (expect-text (role button :name "Prevented inside") "Prevented inside")
    (expect-visible (label "Prevented box"))
    (expect-value (label "Prevented text") "")
    (expect-checked (label "Prevented box") false)
    (expect-disabled (role button :name "Prevented disabled") true)
    (expect-attr (label "Prevented text") "type" "text")
    (expect-has-attr (label "Prevented text") "type")
    (expect-focused (role button :name "Prevented inside"))
    (expect-element (test-id "prevented-zone") html "div")
    (expect-pending-effects 0)
    (expect-scrolls 0)
    (expect-transitions 0)
    (expect-observed 0)
    (expect-reports-replaced 0)
    (expect-saves 0)
    (expect-clipboard-writes 0)
    (mark-metrics)
    (expect-metric-delta patches_emitted 0)
    (expect-metric-delta-at-most patches_emitted 0)
    (set-online offline)
    (set-online online)
    (set-visibility hidden)
    (set-visibility visible)
    (dismiss)
    (expect-shown (label "Prevented") hidden)
    ; (press "Escape"): does not grant it
    (navigate "/?round=26#top-layer")
    (click (role button :name "Open prevented"))
    (dismiss)
    (expect-shown (label "Prevented") modal)
    (press "Escape")
    (expect-shown (label "Prevented") hidden)
    ; (dismiss): does not grant it
    (navigate "/?round=27#top-layer")
    (click (role button :name "Open prevented"))
    (dismiss)
    (expect-shown (label "Prevented") modal)
    (dismiss)
    (expect-shown (label "Prevented") hidden)))
