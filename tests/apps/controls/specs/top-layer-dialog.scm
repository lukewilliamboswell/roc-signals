(test "Top layer — modal close restores focus and disposes only its content"
  (setup (initial-location "/#top-layer"))
  (steps
    (expect-shown (label "Modal") hidden)
    (expect-absent (label "Modal first"))
    (click (role button :name "Open modal"))
    (expect-shown (label "Modal") modal)
    (expect-attr (label "Modal") open "")
    (expect-focused (label "Modal first"))
    (press "Tab")
    (expect-focused (role button :name "Close modal"))
    (press "Tab")
    (expect-focused (role button :name "Scroll modal"))
    (press "Tab")
    (expect-no-focus)
    (press "Tab")
    (expect-focused (label "Modal first"))
    (dismiss)
    (expect-shown (label "Modal") hidden)
    (expect-focused (role button :name "Open modal"))
    (expect-absent (label "Modal first"))
    (click (role button :name "Open modal"))
    (click (role button :name "Close modal"))
    (expect-shown (label "Modal") hidden)
    (expect-focused (role button :name "Open modal"))))
