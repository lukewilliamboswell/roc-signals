(test "Top layer — a document keymap that prevents Escape keeps a dialog open"
  (setup (initial-location "/#top-layer"))
  (steps
    (click (role button :name "Open guarded"))
    (expect-shown (label "Guarded") modal)
    (dismiss)
    (expect-shown (label "Guarded") modal)
    (expect-text (test-id "guard-events") "1|0|0")
    (dismiss)
    (expect-shown (label "Guarded") modal)
    (expect-text (test-id "guard-events") "2|0|0")
    (click (role button :name "Close guarded"))
    (expect-shown (label "Guarded") hidden)
    (expect-text (test-id "guard-events") "2|0|1")
    (click (role button :name "Open passing"))
    (expect-shown (label "Guarded") modal)
    (dismiss)
    (expect-shown (label "Guarded") hidden)
    (expect-text (test-id "guard-events") "3|1|2")
    (expect-focused (role button :name "Open passing"))))
