(test "Top layer — automatic popovers dismiss while manual popovers stay"
  (setup (initial-location "/#top-layer"))
  (steps
    (click (role button :name "Open auto A"))
    (expect-shown (label "Auto A") popover)
    (expect-focused (role button :name "Open auto A"))
    (dismiss)
    (expect-shown (label "Auto A") hidden)
    (click (role button :name "Open auto A"))
    (click (role button :name "Open auto B"))
    (expect-shown (label "Auto A") hidden)
    (expect-shown (label "Auto B") popover)
    (click (role button :name "Outside"))
    (expect-shown (label "Auto B") hidden)
    (click (role button :name "Open manual"))
    (expect-shown (label "Manual") popover)
    (dismiss)
    (expect-shown (label "Manual") popover)
    (click (role button :name "Outside"))
    (expect-shown (label "Manual") popover)
    (click (role button :name "Close manual"))
    (expect-shown (label "Manual") hidden)))
