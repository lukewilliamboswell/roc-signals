(test "Typed controls deliver checked bits and current keyed choices"
  (setup (initial-location "/#typed-controls"))
  (steps
    (expect-text (test-id "typed-checked") "unchecked:0")
    (check (label "Typed checkbox"))
    (expect-text (test-id "typed-checked") "checked:1")
    (uncheck (label "Typed checkbox"))
    (expect-text (test-id "typed-checked") "unchecked:2")
    (check (label "Typed radio"))
    (expect-text (test-id "typed-checked") "checked:3")
    (select-option (label "Typed choice") "teal")
    (expect-text (test-id "typed-choice-status") "chose:teal:0")
    (click (role button :name "Remove teal choice"))
    (change (label "Typed choice") "teal")
    (expect-text (test-id "typed-choice-status") "not-offered")
    (expect-text (test-id "typed-selected") "teal:0")
    (change (label "Typed choice") "foreign")
    (expect-text (test-id "typed-choice-status") "not-offered")
    (click (role button :name "Refresh choices"))
    (click (role button :name "Reverse choices"))
    (select-option (label "Typed choice") "teal")
    (expect-text (test-id "typed-choice-status") "chose:teal:1")
    (expect-text (test-id "typed-selected") "teal:1")
    (change (label "Wrong checked target") "ignored")
    (expect-text (test-id "typed-choice-status") "chose:teal:1")
    (change (label "SVG checked target") "on")
    (change (label "SVG row checked target") "on")
    (change (label "Nested SVG checked target") "on")
    (expect-text (test-id "typed-choice-status") "chose:teal:1")
    (change (label "Foreign object checked target") "on")
    (expect-text (test-id "typed-choice-status") "foreign-object-fired")))
