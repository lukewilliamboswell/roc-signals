(test "AES-GCM authenticates bytes, password and associated data before opening"
  (steps
    (click (role button :name "Unlock SHA-256"))
    (run-effect 1)
    (expect-keys 1)
    (click (role button :name "Seal"))
    (run-effect 2)
    (expect-text (test-id "result") "sealed iv=12 bytes=25")
    (click (role button :name "Open"))
    (run-effect 3)
    (expect-text (test-id "plaintext") "secret λ")
    (click (role button :name "Wrong associated data"))
    (run-effect 4)
    (expect-text (test-id "result") "failed NotAuthentic")
    (click (role button :name "Tampered ciphertext"))
    (run-effect 5)
    (expect-text (test-id "result") "failed NotAuthentic")
    (click (role button :name "Lock"))
    (expect-keys 0)
    (fill (label "Password") "wrong password")
    (click (role button :name "Unlock SHA-256"))
    (run-effect 6)
    (click (role button :name "Open"))
    (run-effect 7)
    (expect-text (test-id "result") "failed NotAuthentic")
    (expect-text (test-id "plaintext") "")
    (click (role button :name "Lock"))
    (fill (label "Password") "correct horse")
    (click (role button :name "Unlock SHA-256"))
    (run-effect 8)
    (click (role button :name "Open"))
    (run-effect 9)
    (expect-text (test-id "plaintext") "secret λ")
    (click (role button :name "Seal"))
    (run-effect 10)
    (expect-text (test-id "fresh-iv") "True")
    (click (role button :name "Lock"))
    (expect-keys 0)))
