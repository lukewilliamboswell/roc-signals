(test "An empty password and empty authenticated plaintext are valid inputs"
  (steps
    (fill (label "Password") "")
    (fill (label "Plaintext") "")
    (click (role button :name "Unlock SHA-256"))
    (run-effect 1)
    (expect-keys 1)
    (click (role button :name "Seal"))
    (run-effect 2)
    (expect-text (test-id "result") "sealed iv=12 bytes=16")
    (click (role button :name "Lock"))
    (expect-keys 0)
    (click (role button :name "Unlock SHA-256"))
    (run-effect 3)
    (click (role button :name "Open"))
    (run-effect 4)
    (expect-text (test-id "result") "opened")
    (expect-text (test-id "plaintext") "")
    (click (role button :name "Reset"))
    (expect-keys 0)
    (expect-pending-effects 0)))
