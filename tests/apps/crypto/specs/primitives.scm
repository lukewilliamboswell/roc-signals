(test "Secure bytes and SHA-2 have the same results in both runners"
  (steps
    (expect-keys 0)
    (click (role button :name "Random zero"))
    (run-effect 1)
    (expect-text (test-id "result") "random 0")
    (click (role button :name "New salt"))
    (run-effect 2)
    (expect-text (test-id "result") "random 16")
    (click (role button :name "SHA-256"))
    (run-effect 3)
    (expect-text (test-id "result") "digest ungWv48Bz+pBQUDeXa4iI7ADYaOWF3qctBD/YfIAFa0=")
    (click (role button :name "SHA-384"))
    (run-effect 4)
    (expect-text (test-id "result") "digest ywB1P0WjXou1oD1pmsZQBycsMqsO3tFjGotgWkP/W+2AhgcroefMI1i67KE0yCWn")
    (click (role button :name "SHA-512"))
    (run-effect 5)
    (expect-text (test-id "result") "digest 3a81oZNherrMQXNJriBBMRLm+k6JqX6iCp7u5ktV05ohkpkqJ0/BqDa6PCOj/uu9RU1EI2Q86A4qmslPpUyknw==")
    (expect-pending-effects 0)
    (expect-keys 0)))
