(test "Round trip — derive, seal, lock, derive again, open and reset"
  (steps
    (mark-metrics)
    (click (role button :name "Unlock SHA-256"))
    (run-effect 1)
    (click (role button :name "Seal"))
    (run-effect 2)
    (click (role button :name "Lock"))
    (expect-keys 0)
    (click (role button :name "Unlock SHA-256"))
    (run-effect 3)
    (click (role button :name "Open"))
    (run-effect 4)
    (expect-text (test-id "plaintext") "secret λ")
    (click (role button :name "Reset"))
    (expect-text (test-id "key") "locked")
    (expect-text (test-id "result") "idle")
    (expect-text (test-id "plaintext") "")
    (expect-pending-effects 0)
    (expect-keys 0)))
