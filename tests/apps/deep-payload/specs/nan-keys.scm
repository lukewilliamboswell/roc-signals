(test "Deep payload — a dictionary with one NaN key crosses both ways, and one with two is NanKeys, refused before it is sent or answered"
  (steps
    (fill (label "Levels") "1")
    (click (role button :name "Send NaN keys"))
    (expect-pending-work "test.roc-signals/deep-payload/count-keys" 1)
    (run-effect 1)
    (expect-text (test-id "nan-sent") "1 keys")
    (click (role button :name "Ask NaN keys"))
    (expect-pending-work "test.roc-signals/deep-payload/make-keys" 1)
    (run-effect 2)
    (expect-text (test-id "nan-asked") "1 keys")
    ; Two NaN keys: the page holds both, but they would be written alike.
    (fill (label "Levels") "2")
    (click (role button :name "Send NaN keys"))
    (expect-pending-work "test.roc-signals/deep-payload/count-keys" 0)
    (expect-pending-effects 0)
    (expect-text (test-id "nan-sent") "NaN keys")
    (click (role button :name "Ask NaN keys"))
    (expect-pending-work "test.roc-signals/deep-payload/make-keys" 1)
    (run-effect 3)
    (expect-text (test-id "nan-asked") "NaN keys")
    ; The worker was kept, and the next job answers.
    (fill (label "Levels") "1")
    (click (role button :name "Ask NaN keys"))
    (run-effect 4)
    (expect-text (test-id "nan-asked") "1 keys")
    (expect-pending-effects 0)
  )
)
