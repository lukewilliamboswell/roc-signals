(test "prepared descriptions bind runtime data and create fresh scoped state"
  (setup (initial-time 47))
  (steps
    (expect-visible (test-id "region"))
    (expect-text (test-id "stamp") "47")
    (expect-text (test-id "cell-above") "0/0")
    (expect-text (test-id "local-above") "0/0")
    (click (role button :name "Cell above"))
    (expect-text (test-id "cell-above") "1/2")
    (expect-text (test-id "local-above") "0/1")
    (click (role button :name "Local above"))
    (expect-text (test-id "cell-above") "1/4")
    (expect-text (test-id "local-above") "2/2")
    (click (role button :name "Tap one"))
    (expect-text (test-id "row-one") "one:1")
    (expect-text (test-id "row-two") "two:0")
    (mark-metrics)
    (click (role button :name "Reverse"))
    (expect-text (test-id "row-one") "one:1")
    (expect-metric-delta rows_created 0)
    (expect-metric-delta rows_removed 0)
    (click (role button :name "Toggle"))
    (expect-absent (test-id "region"))
    (click (role button :name "Score"))
    (click (role button :name "Toggle"))
    (expect-text (test-id "cell-above") "0/6")
    (expect-text (test-id "local-above") "0/3")
    (expect-text (test-id "row-one") "one:1")))
