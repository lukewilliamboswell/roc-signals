(test "upload options and exact progress counts share the ordinary effect turn"
  (setup (file "a.txt" "text/plain" "abcd"))
  (steps
    (choose-files (label "Upload") "a.txt")
    (click (role button :name "Send progress"))
    (expect-request 1 :method "POST" :url "/upload" :cache default :credentials include)
    (mark-metrics)
    (hold-reports)
    (progress-effect 1 sending 9007199254740993 18446744073709551615)
    (progress-effect 1 receiving 18446744073709551614 unknown)
    (expect-reports-replaced 1)
    (expect-text (test-id "transfer-progress") "waiting")
    (expect-pending-effects 1)
    (release-reports)
    (expect-text (test-id "transfer-progress") "receiving 18446744073709551614/unknown")
    (expect-metric-delta effects_progress 1)
    (expect-metric-delta effects_delivered 0)
    (hold-reports)
    (progress-effect 1 sending 4 4)
    (stub-http "sent" :url "/upload" :status 200 :body "ok")
    (run-effect 1)
    (expect-text (test-id "transfer-progress") "sending 4/4")
    (expect-text (test-id "transfer-result") "sent ok")
    (expect-pending-effects 0)
    (expect-metric-delta effects_progress 2)
    (expect-metric-delta effects_delivered 1)
    (release-reports)))
