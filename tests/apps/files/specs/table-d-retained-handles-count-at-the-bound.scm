(test "The 64-handle bound includes Files retained only by the last table record"
  (setup (file "bound.txt" "text/plain" "bound"))
  (steps
    (expect-files 0)
    (drop-files (label "Table files") "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt" "bound.txt")
    (expect-text (test-id "table-rows") "table rows 64")
    (expect-files 64)
    (click (role button :name "Remove table files"))
    (expect-text (test-id "table-rows") "table rows 0")
    (expect-files 64)
    (click (role button :name "Table unrelated"))
    (expect-files 64)
    (drop-files (label "Table files") "bound.txt")
    (expect-text (test-id "table-refused") "table refused 1")
    (expect-text (test-id "table-rows") "table rows 0")
    (expect-files 64)
    (click (role button :name "Next table write"))
    (expect-files 0)
    (drop-files (label "Table files") "bound.txt")
    (expect-text (test-id "table-refused") "table refused 0")
    (expect-text (test-id "table-rows") "table rows 1")
    (expect-files 1)
  ))
