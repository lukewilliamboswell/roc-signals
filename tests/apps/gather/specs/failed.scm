(test "Gather — a job's own failure and a lost job fail the whole answer once the others settle, and a failure keeps no previous total"
  (steps
    (run-effect 1)
    (run-effect 2)
    (check (label "Fail the second shard"))
    (expect-pending-effects 2)
    (run-effect 4)
    (expect-text (test-id "jobs") "… unlucky")
    (expect-text (test-id "total") "working (previous: 303)")
    (run-effect 3)
    (expect-text (test-id "jobs") "168 unlucky")
    (expect-text (test-id "total") "failed: unlucky")
    (uncheck (label "Fail the second shard"))
    (expect-text (test-id "total") "working (previous: none)")
    (lose-work 5 app_crash)
    (expect-text (test-id "jobs") "lost …")
    (run-effect 6)
    (expect-text (test-id "jobs") "lost 135")
    (expect-text (test-id "total") "failed: lost")
  )
)
