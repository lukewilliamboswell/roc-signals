(test "Gather — shards answer one by one in any order, the total follows the last, and a new question keeps the previous total until it settles"
  (steps
    (expect-pending-effects 2)
    (expect-text (test-id "jobs") "… …")
    (expect-text (test-id "total") "working (previous: none)")
    (run-effect 2)
    (expect-text (test-id "jobs") "… 135")
    (expect-text (test-id "total") "working (previous: none)")
    (run-effect 1)
    (expect-text (test-id "jobs") "168 135")
    (expect-text (test-id "total") "303")
    (mark-metrics)
    (fill (label "Shards") "4")
    (expect-pending-effects 4)
    (expect-metric-delta effects_cancelled 0)
    (expect-text (test-id "jobs") "… … … …")
    (expect-text (test-id "total") "working (previous: 303)")
    (run-effect 4)
    (expect-text (test-id "jobs") "… 73 … …")
    ; A newer question stops every job of the one before.
    (mark-metrics)
    (fill (label "Shards") "3")
    (expect-metric-delta effects_cancelled 3)
    (expect-pending-effects 3)
    (expect-text (test-id "jobs") "… … …")
    (run-effect 8)
    (run-effect 7)
    (expect-text (test-id "total") "working (previous: 303)")
    (run-effect 9)
    (expect-text (test-id "jobs") "121 96 86")
    (expect-text (test-id "total") "303")
  )
)
