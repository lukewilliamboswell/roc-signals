    (expect-text (test-id "n") "n=9223372036854775806")
    (expect-metric-delta derived_calls_into_roc 62)
    (expect-metric-delta set_text 62)
    ; The next event wraps its second write to -2, observed once.
    (mark-metrics)
    (click (role button :name "n+1, then double"))
    (expect-text (test-id "n") "n=-2")
    (expect-metric-delta derived_calls_into_roc 1)
    (expect-metric-delta set_text 1)
    ; (-2 + 1) * 2 stays -2: the write still wakes the reader, and the hole
    ; prunes the equal result instead of exposing the intermediate -1.
    (mark-metrics)
    (click (role button :name "n+1, then double"))
    (expect-text (test-id "n") "n=-2")
    (expect-metric-delta derived_calls_into_roc 1)
    (expect-metric-delta set_text 0)
  ))
