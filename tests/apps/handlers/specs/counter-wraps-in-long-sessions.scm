(test "Handlers — composed counter writes wrap and keep one observation per event in long sessions"
  (steps
    (expect-text (test-id "n") "n=0")
    ; After 62 events, (n + 1) * 2 reaches I64.max - 1. Each event still
    ; evaluates the one reader exactly once after both writes.
    (mark-metrics)
    (click (role button :name "n+1, then double"))
    (click (role button :name "n+1, then double"))
    (click (role button :name "n+1, then double"))
    (click (role button :name "n+1, then double"))
