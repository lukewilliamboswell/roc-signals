(test "current results belong to the latest issuing step even after A B A"
  (steps
    (expect-text (test-id "answers") "no results")
    (fill (label "Question") "A")
    (fill (label "Question") "B")
    (fill (label "Question") "A")
    (expect-pending-effects 3)
    (stub-http "new A" :url "/current/A/0" :status 200 :body "new")
    (run-effect 3)
    (expect-text (test-id "answers") "A:0:new")
    (mark-metrics)
    (stub-http "old A" :url "/current/A/0" :status 200 :body "old")
    (run-effect 1)
    (stub-http "old B" :url "/current/B/0" :status 200 :body "old")
    (run-effect 2)
    (expect-text (test-id "answers") "A:0:new")
    (expect-pending-effects 0)
    (expect-metric-delta effects_delivered 2)
    (expect-metric-delta effects_cancelled 0)
    (expect-metric-delta patches_emitted 0)))
