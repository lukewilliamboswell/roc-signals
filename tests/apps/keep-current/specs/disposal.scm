(test "a current orphan requires the question still asked in its ancestor"
  (steps
    (fill (label "Question") "A")
    (uncheck (label "Shown"))
    (expect-text (test-id "site-status") "hidden")
    (expect-pending-effects 1)
    (progress-effect 1 receiving 4 unknown)
    (expect-text (test-id "progress") "A:4")
    (stub-http "kept A" :url "/current/A/0" :status 200 :body "kept")
    (run-effect 1)
    (expect-text (test-id "answers") "A:0:kept")
    (check (label "Shown"))
    (expect-pending-effects 1)
    (click (role button :name "Hide and choose B"))
    (expect-text (test-id "site-status") "hidden")
    (mark-metrics)
    (progress-effect 1 receiving 8 unknown)
    (stub-http "abandoned A" :url "/current/A/0" :status 200 :body "wrong")
    (run-effect 2)
    (expect-text (test-id "answers") "A:0:kept")
    (expect-text (test-id "progress") "A:4")
    (expect-pending-effects 0)
    (expect-metric-delta effects_progress 1)
    (expect-metric-delta effects_delivered 1)
    (expect-metric-delta effects_skipped 0)
    (expect-metric-delta patches_emitted 0)))
