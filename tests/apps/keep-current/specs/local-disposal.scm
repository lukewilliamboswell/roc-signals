(test "only the current disposed local result attempts its retired write"
  (steps
    (click (role button :name "Open local"))
    (expect-text (test-id "local-status") "open")
    (expect-text (test-id "local-value") "1")
    (click (role button :name "Advance local"))
    (expect-text (test-id "local-value") "2")
    (expect-pending-effects 2)
    (click (role button :name "Close local"))
    (expect-text (test-id "local-status") "closed")
    (mark-metrics)
    (stub-http "old local" :url "/current/local/1" :status 200 :body "old")
    (run-effect 1)
    (expect-metric-delta effects_delivered 1)
    (expect-metric-delta effects_skipped 0)
    (stub-http "latest local" :url "/current/local/2" :status 200 :body "new")
    (run-effect 2)
    (expect-text (test-id "local-status") "closed")
    (expect-text (test-id "answers") "no results")
    (expect-pending-effects 0)
    (expect-metric-delta effects_delivered 2)
    (expect-metric-delta effects_skipped 1)))
