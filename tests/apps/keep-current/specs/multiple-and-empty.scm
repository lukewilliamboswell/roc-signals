(test "one step owns all its requests and an empty step invalidates them"
  (steps
    (check (label "Two requests"))
    (fill (label "Question") "A")
    (expect-pending-effects 2)
    (stub-http "second" :url "/current/A/1" :status 200 :body "second")
    (run-effect 2)
    (stub-http "first" :url "/current/A/0" :status 200 :body "first")
    (run-effect 1)
    (expect-text (test-id "answers") "A:1:second|A:0:first")
    (fill (label "Question") "B")
    (expect-pending-effects 2)
    (fill (label "Question") "")
    (mark-metrics)
    (stub-http "old second" :url "/current/B/1" :status 200 :body "wrong")
    (run-effect 4)
    (stub-http "old first" :url "/current/B/0" :status 200 :body "wrong")
    (run-effect 3)
    (expect-text (test-id "answers") "A:1:second|A:0:first")
    (expect-pending-effects 0)
    (expect-metric-delta effects_delivered 2)
    (expect-metric-delta effects_cancelled 0)
    (expect-metric-delta patches_emitted 0)))
