(test "withheld progress is counted without reading or writing an older step"
  (steps
    (fill (label "Question") "A")
    (fill (label "Question") "B")
    (expect-pending-effects 2)
    (expect-text (test-id "progress") "none")
    (mark-metrics)
    (progress-effect 1 receiving 7 unknown)
    (expect-text (test-id "progress") "none")
    (expect-metric-delta effects_progress 1)
    (expect-metric-delta effects_delivered 0)
    (expect-metric-delta patches_emitted 0)
    (progress-effect 2 receiving 9 unknown)
    (expect-text (test-id "progress") "B:9")
    (expect-metric-delta effects_progress 2)
    (stub-http "B" :url "/current/B/0" :status 200 :body "new")
    (run-effect 2)
    (stub-http "A" :url "/current/A/0" :status 200 :body "old")
    (run-effect 1)
    (expect-text (test-id "answers") "B:0:new")
    (expect-pending-effects 0)))
