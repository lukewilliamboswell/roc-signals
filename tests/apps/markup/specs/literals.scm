(test "literals retain element namespaces, exact names and Boolean presence"
  (steps
    (expect-text (test-id "static-card") "Literal cardfixed & escaped")
    (expect-attr (test-id "static-card") data-n "app-node")
    (expect-attr (test-id "static-card") data-h "app-hole")
    (expect-text (test-id "literal-text") "first")
    (expect-text (test-id "bound-id") "first")
    (expect-text (test-id "literal-count") "0")
    (expect-disabled (label "Literal disabled") true)
    (expect-attr (test-id "literal-hidden") hidden "until-found")
    (expect-text (test-id "literal-template") "")
    (expect-absent (test-id "inert-descendant") :never-drawn)
    (expect-text (test-id "xml-template") "")
    (expect-absent (test-id "xml-inert-descendant") :never-drawn)
    (expect-element (test-id "literal-path") svg "path")
    (expect-attr (test-id "literal-path") pathLength "10")
    (expect-element (test-id "literal-math") mathml "math")
    (expect-text (test-id "literal-math") "x+0")
    (expect-element (test-id "html-one") html "li")
    (expect-element (test-id "svg-one") svg "g")
    (expect-element (test-id "foreign-one") html "div")
    (expect-text (test-id "foreign-one") "one")))
