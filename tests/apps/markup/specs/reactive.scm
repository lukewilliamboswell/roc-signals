(test "literal bindings refresh ordinary holes and prune equal values"
  (steps
    (mark-metrics)
    (click (role button :name "Step"))
    (expect-text (test-id "literal-text") "second")
    (expect-text (test-id "bound-id") "second")
    (expect-text (test-id "literal-count") "1")
    (expect-text (test-id "literal-math") "x+1")
    (expect-text (test-id "literal-region") "second")
    (expect-metric-delta set_text 5)
    (expect-metric-delta patches_emitted 7)
    (expect-metric-delta rows_created 0)
    (expect-metric-delta rows_removed 0)
    (mark-metrics)
    (click (role button :name "Same"))
    (expect-text (test-id "literal-count") "1")
    (expect-metric-delta patches_emitted 0)
    (expect-metric-delta set_text 0)
    (expect-metric-delta rows_created 0)
    (expect-metric-delta rows_removed 0)))
