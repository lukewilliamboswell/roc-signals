(test "Ordinary constructors preserve explicit namespaces and raw SVG context"
  (steps
    (expect-text (test-id "context-root") "Change namespaced attributeToggle namespace subtreeexact HTMLlocal colonprefixed HTMLextensionno namespacexforeign HTML")
    (expect-element (test-id "context-root") html "div")
    (expect-value (test-id "exact-value") "")
    (expect-element (test-id "exact-value") html "input")
    (expect-text (test-id "exact-dialog") "")
    (expect-element (test-id "exact-dialog") html "dialog")
    (expect-shown (test-id "exact-dialog") hidden)
    (expect-text (test-id "exact-html") "exact HTML")
    (expect-element (test-id "exact-html") html "DIV")
    (expect-text (test-id "colon-local") "local colon")
    (expect-element (test-id "colon-local") html "h:div")
    (expect-text (test-id "prefixed-html") "prefixed HTML")
    (expect-element (test-id "prefixed-html") html "div")
    (expect-text (test-id "extension") "extension")
    (expect-element (test-id "extension") "urn:entry" "entry")
    (expect-text (test-id "no-namespace") "no namespace")
    (expect-element (test-id "no-namespace") none "entry")
    (expect-text (test-id "math-symbol") "x")
    (expect-element (test-id "math-symbol") mathml "mi")
    (expect-text (test-id "gradient") "")
    (expect-element (test-id "gradient") svg "linearGradient")
    (expect-text (test-id "foreign-html") "foreign HTML")
    (expect-element (test-id "foreign-html") html "div")
    (click (role button :name "Change namespaced attribute"))
    (expect-element (test-id "gradient") svg "linearGradient")
    (click (role button :name "Toggle namespace subtree"))
    (expect-absent (test-id "svg-group"))
    (click (role button :name "Toggle namespace subtree"))
    (expect-element (test-id "gradient") svg "linearGradient")
    (expect-element (test-id "foreign-html") html "div")))
