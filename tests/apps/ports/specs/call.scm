(test "Ports — a call is answered once, and every failure is a typed value"
  (steps
    (click (role button :name "Get"))
    (expect-pending-effects 1)
    (expect-port-call 1 "test.roc-signals/get" "{\"key\":\"k1\"}")
    (answer-port 1 reply "{\"value\":\"one\",\"ignored\":[1,2]}")
    (expect-text (test-id "log") "get k1:one")
    (expect-pending-effects 0)
    (click (role button :name "Get"))
    (answer-port 2 reply "{\"value\":5}")
    (expect-text (test-id "log") "get k1:one|get k2:undecodable port \"test.roc-signals/get\": expected a string at byte 9")
    (click (role button :name "Get"))
    (answer-port 3 throw "no store")
    (click (role button :name "Get"))
    (answer-port 4 timeout)
    (click (role button :name "Get"))
    (answer-port 5 too-large)
    (expect-text (test-id "log") "get k1:one|get k2:undecodable port \"test.roc-signals/get\": expected a string at byte 9|get k3:threw no store|get k4:timeout|get k5:too large")
    (mark-metrics)
    (click (role button :name "Get"))
    (expect-metric-delta effects_issued 1)
    (expect-metric-delta effects_delivered 0)
  )
)
