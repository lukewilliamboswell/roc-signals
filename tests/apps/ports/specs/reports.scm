(test "Ports — Latest reports replace within a frame and Every and close stay occurrences"
  (steps
    (click (role button :name "Panel"))
    (click (role button :name "Feed"))
    (mark-metrics)
    (hold-reports)
    (emit-port "test.roc-signals/ticks" "1")
    (emit-port "test.roc-signals/ticks" "2")
    (emit-port "test.roc-signals/ticks" "3")
    (expect-text (test-id "log") "")
    (expect-reports-replaced 2)
    (emit-port "test.roc-signals/feed" "\"first\"")
    (expect-text (test-id "log") "tick:3|feed:first")
    (emit-port "test.roc-signals/ticks" "4")
    (emit-port "test.roc-signals/ticks" "5")
    (close-port "test.roc-signals/ticks")
    (expect-text (test-id "log") "tick:3|feed:first|tick:5|tick:closed")
    (expect-reports-replaced 3)
    (release-reports)
    (expect-metric-delta effects_delivered 4)
    (hold-reports)
    (emit-port "test.roc-signals/feed" "\"second\"")
    (emit-port "test.roc-signals/feed" "\"third\"")
    (expect-text (test-id "log") "tick:3|feed:first|tick:5|tick:closed|feed:second|feed:third")
    (expect-reports-replaced 3)
    (release-reports)))
