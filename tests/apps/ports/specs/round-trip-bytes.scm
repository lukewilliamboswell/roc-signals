(test "Ports — reply and subscription fixtures carry bytes beside unchanged JSON"
  (steps
    (mark-metrics)
    (click (role button :name "Echo"))
    (expect-port-call 1 "test.roc-signals/echo" "{\"$bytes\":0}")
    (answer-port 1 reply "{\"$bytes\":1}" :bytes ("AA==" "AID/"))
    (expect-text (test-id "log") "echo:3 0 255")
    (click (role button :name "Echo"))
    (answer-port 2 reply "{\"$bytes\":0}" :bytes (""))
    (expect-text (test-id "log") "echo:3 0 255|echo:0 0 0")
    (click (role button :name "Binary feed"))
    (expect-port-subscriptions "test.roc-signals/binary" 1)
    (emit-port "test.roc-signals/binary" "{\"$bytes\":1}" :bytes ("Zm9v" "AP9/gA=="))
    (expect-text (test-id "log") "echo:3 0 255|echo:0 0 0|binary:[0, 255, 127, 128]")
    (hold-reports)
    (emit-port "test.roc-signals/binary" "{\"$bytes\":0}" :bytes ("AQ=="))
    (emit-port "test.roc-signals/binary" "{\"$bytes\":0}" :bytes ("AgD/"))
    (expect-reports-replaced 1)
    (release-reports)
    (expect-text (test-id "log") "echo:3 0 255|echo:0 0 0|binary:[0, 255, 127, 128]|binary:[2, 0, 255]")
    (click (role button :name "Binary feed"))
    (expect-port-subscriptions "test.roc-signals/binary" 0)
    (expect-pending-effects 0)
    (click (role button :name "Clear log"))
    (expect-text (test-id "log") "")))
