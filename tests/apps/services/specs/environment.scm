(test "Environment facts and explicit timer clock samples"
  (setup
    (initial-location "/#environment")
    (initial-time "1969-12-31T23:59:59.999Z")
    (seed 340282366920938463463374607431768211455)
    (languages "en-AU" "fr")
    (time-zone "test" -60 (0 90)))
  (steps
    (expect-text (test-id "boot-time") "-1")
    (expect-text (test-id "boot-seed") "340282366920938463463374607431768211455")
    (expect-text (test-id "boot-languages") "en-AU,fr")
    (expect-text (test-id "boot-zone") "test")
    (set-time -100)
    (expect-text (test-id "sample-time") "-1")
    (run-effect 1)
    (expect-text (test-id "sample-time") "-100")
    (advance-time 200)
    (expect-text (test-id "sample-time") "-100")
    (click (role button :name "Sample clock"))
    (run-effect 2)
    (expect-text (test-id "sample-time") "100")
    (expect-text (test-id "boot-time") "-1")
    (set-time -200)
    (tick-interval 1000)
    (expect-text (test-id "sample-time") "-200")))
