(test "Services — a frame keeps each source's latest report and occurrences drain it first"
  (steps
    (mark-metrics)
    (hold-reports)
    (set-online offline)
    (set-online online)
    (set-online offline)
    (expect-reports-replaced 2)
    (expect-text (test-id "online") "online")
    (expect-metric-delta effects_delivered 0)
    (release-reports)
    (expect-text (test-id "online") "offline")
    (expect-metric-delta effects_delivered 1)
    (hold-reports)
    (set-online online)
    (click (role button :name "Start"))
    (expect-text (test-id "online") "online")
    (expect-interval 5000 1)
    (set-visibility hidden)
    (set-visibility visible)
    (set-visibility hidden)
    (expect-text (test-id "visible") "visible")
    (expect-reports-replaced 4)
    (release-reports)
    (expect-text (test-id "visible") "hidden")
    (expect-interval 5000 0)
    (navigate "/another-document")
    (expect-reports-replaced 0)))
