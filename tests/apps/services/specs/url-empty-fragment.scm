(test "Services — an empty fragment remains in the current document"
  (setup (initial-location "/url-probe/history?before=%26#start"))
  (steps
    (click (role button :name "Push empty fragment"))
    (expect-current-location "/url-probe/history?before=%26")
    (history-back)
    (expect-text (test-id "received-location") "/url-probe/history?before=%26#start")
    (history-forward)
    (expect-text (test-id "received-location") "/url-probe/history?before=%26")
    (click (role button :name "Replace raw URL"))
    (click (role link :name "Follow empty fragment"))
    (expect-current-location "/url-probe/history?before=%26")
    (expect-text (test-id "received-location") "/url-probe/history?before=%26")
    (expect-text (test-id "url-replacements") "1")
    (click (role button :name "Replace raw URL"))
    (navigate "/url-probe/history?before=%26#")
    (expect-current-location "/url-probe/history?before=%26")
    (expect-text (test-id "received-location") "/url-probe/history?before=%26")
    (expect-text (test-id "url-replacements") "2")))
