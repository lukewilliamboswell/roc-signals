(test "Services — empty history arguments differ from blank references"
  (setup (initial-location "/url-probe/history?before=%26#start"))
  (steps
    (click (role button :name "Push empty URL"))
    (expect-current-location "/url-probe/history?before=%26#start")
    (click (role button :name "Replace empty URL"))
    (expect-current-location "/url-probe/history?before=%26#start")
    (history-back)
    (expect-text (test-id "url-traversals") "1")
    (history-forward)
    (expect-text (test-id "url-traversals") "2")
    (click (role button :name "Push blank URL"))
    (expect-current-location "/url-probe/history?before=%26")
    (history-back)
    (expect-text (test-id "received-location") "/url-probe/history?before=%26#start")
    (history-forward)
    (expect-text (test-id "received-location") "/url-probe/history?before=%26")
    (click (role button :name "Push empty query"))
    (expect-current-location "/url-probe/history")
    (history-back)
    (expect-text (test-id "received-location") "/url-probe/history?before=%26")
    (history-forward)
    (expect-text (test-id "received-location") "/url-probe/history")))
