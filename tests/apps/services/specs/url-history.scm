(test "Services — url history"
  (setup (initial-location "/url-probe/history?before=%26#start"))
  (steps
    (expect-current-location "/url-probe/history?before=%26#start")
    (expect-text (test-id "received-location") "/url-probe/history?before=%26#start")
    (click (role button :name "Push raw URL"))
    (expect-current-location "/url-probe/history?p=caf%C3%A9%20au%20lait%22%27`{}#p=%22%3C%3E%60{}")
    (expect-text (test-id "received-location") "/url-probe/history?before=%26#start")
    (history-back)
    (expect-current-location "/url-probe/history?before=%26#start")
    (expect-text (test-id "received-location") "/url-probe/history?before=%26#start")
    (history-forward)
    (expect-current-location "/url-probe/history?p=caf%C3%A9%20au%20lait%22%27`{}#p=%22%3C%3E%60{}")
    (expect-text (test-id "received-location") "/url-probe/history?p=caf%C3%A9%20au%20lait%22%27`{}#p=%22%3C%3E%60{}")
    (click (role button :name "Replace raw URL"))
    (expect-current-location "/url-probe/history?p=caf%C3%A9%20au%20lait%22%27`{}#r=caf%C3%A9%20au%20lait%22%3C%3E%60{}'?#")
    (expect-text (test-id "received-location") "/url-probe/history?p=caf%C3%A9%20au%20lait%22%27`{}#p=%22%3C%3E%60{}")
    (history-back)
    (expect-current-location "/url-probe/history?before=%26#start")
    (expect-text (test-id "received-location") "/url-probe/history?before=%26#start")
    (history-forward)
    (expect-current-location "/url-probe/history?p=caf%C3%A9%20au%20lait%22%27`{}#r=caf%C3%A9%20au%20lait%22%3C%3E%60{}'?#")
    (expect-text (test-id "received-location") "/url-probe/history?p=caf%C3%A9%20au%20lait%22%27`{}#r=caf%C3%A9%20au%20lait%22%3C%3E%60{}'?#")
    (expect-text (test-id "url-replacements") "1")
  ))
