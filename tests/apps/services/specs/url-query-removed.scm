(test "Services — dropping an empty query creates a new document"
  (setup (initial-location "/url-probe/query?"))
  (steps
    (expect-current-location "/url-probe/query")
    (expect-text (test-id "received-location") "/url-probe/query")
    (click (role button :name "Push empty URL"))
    (history-back)
    (history-forward)
    (click (role button :name "Replace raw URL"))
    (expect-text (test-id "url-replacements") "1")
    (click (role link :name "Drop empty query"))
    (expect-text (test-id "url-replacements") "0")
    (expect-text (test-id "received-location") "/url-probe/query#link")
    (navigate "/url-probe/query?#start")
    (click (role button :name "Replace raw URL"))
    (expect-text (test-id "url-replacements") "1")
    (navigate "/url-probe/query#next")
    (expect-text (test-id "url-replacements") "0")
    (expect-text (test-id "received-location") "/url-probe/query#next")))
