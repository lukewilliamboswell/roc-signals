(test "constant signals initialize controls in blocks and cloned rows"
  (steps
    (expect-value (label "block select") "two")
    (expect-value (label "left select") "two")
    (expect-value (label "right select") "two")
    (expect-value (label "static property") "two")
    (expect-checked (label "block checked") true)
    (expect-checked (label "left checked") true)
    (expect-checked (label "right checked") true)
    (expect-value (label "block input") "draft")
    (expect-value (label "left input") "draft")
    (expect-value (label "right input") "draft")
    (expect-text (test-id "block-constant") "fixed text")
    (expect-text (test-id "left-constant") "fixed text")
    (expect-text (test-id "right-constant") "fixed text")
    (expect-attr (test-id "left-constant") title "fixed title")
    (expect-attr (test-id "right-constant") class "fixed-class")
    (expect-attr (test-id "block-constant") data-empty "")
    (expect-attr (test-id "left-constant") data-empty "")
    (click (role button :name "Focus left"))
    (expect-focused (label "left input"))))
