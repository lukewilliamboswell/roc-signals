(test "a selection interpolation retains row precision beside its row key"
  (steps
    (expect-attr (test-id "choice-row-0") data-choice "yes row-0")
    (expect-attr (test-id "choice-row-1") data-choice "no row-1")
    (expect-attr (test-id "choice-row-2") data-choice "no row-2")
    (mark-metrics)
    (click (role button :name "Choose row-1"))
    (expect-attr (test-id "choice-row-0") data-choice "no row-0")
    (expect-attr (test-id "choice-row-1") data-choice "yes row-1")
    (expect-attr (test-id "choice-row-2") data-choice "no row-2")
    (expect-metric-delta patches_emitted 2)
    (expect-metric-delta-at-most derived_calls_into_roc 8)
    (mark-metrics)
    (click (role button :name "Choose row-2"))
    (expect-attr (test-id "choice-row-1") data-choice "no row-1")
    (expect-attr (test-id "choice-row-2") data-choice "yes row-2")
    (expect-attr (test-id "choice-row-7") data-choice "no row-7")
    (expect-metric-delta patches_emitted 2)
    (expect-metric-delta-at-most derived_calls_into_roc 8)))
