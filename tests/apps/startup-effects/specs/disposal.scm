(test "placeholder effects start only on activation and follow scope disposal"
  (steps
    (expect-text (test-id "waiting") "Waiting")
    (expect-pending-effects 0)
    (expect-cleanup "body" 0)
    (mark-metrics)
    (run-opportunity)
    (expect-visible (test-id "body"))
    (expect-absent (test-id "waiting"))
    (expect-pending-effects 2)
    (expect-metric-delta effects_issued 2)
    (click (role button :name "Toggle"))
    (expect-absent (test-id "body"))
    (expect-cleanup "body" 1)
    (expect-metric-delta effects_cancelled 1)
    (expect-metric-delta effects_reparented 1)
    (expect-pending-effects 1)
    (stub-http "kept" :url "/kept" :status 200 :body "ok")
    (run-effect 1)
    (expect-text (test-id "http") "1")
    (expect-text (test-id "timer") "0")
    (expect-pending-effects 0)
    (click (role button :name "Toggle"))
    (expect-text (test-id "waiting") "Waiting")
    (expect-pending-effects 0)))
