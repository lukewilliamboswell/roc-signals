(test "placeholder effect round trip"
  (steps
    (expect-text (test-id "waiting") "Waiting")
    (expect-text (test-id "http") "0")
    (expect-text (test-id "timer") "0")
    (expect-pending-effects 0)
    (run-opportunity)
    (expect-visible (test-id "body"))
    (stub-http "kept" :url "/kept" :status 200 :body "ok")
    (run-effect 1)
    (run-effect 2)
    (expect-text (test-id "http") "1")
    (expect-text (test-id "timer") "1")
    (click (role button :name "Toggle"))
    (expect-absent (test-id "body"))
    (expect-pending-effects 0)
    (click (role button :name "Reset"))
    (expect-text (test-id "waiting") "Waiting")
    (expect-text (test-id "http") "0")
    (expect-text (test-id "timer") "0")
    (expect-pending-effects 0)))
