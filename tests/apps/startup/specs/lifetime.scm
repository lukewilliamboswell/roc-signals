(test "fixed routes keep placeholders until an explicit ready opportunity"
  (setup (initial-url "/about/?live=1#hash"))
  (steps
    (expect-text (test-id "route") "about")
    (expect-text (test-id "waiting") "Loading")
    (click (role button :name "Increment"))
    (click (role button :name "Ready"))
    (expect-text (test-id "waiting") "Loading")
    (run-opportunity)
    (expect-absent (test-id "waiting"))
    (expect-text (test-id "live") "1/0")
    (click (role button :name "Tap"))
    (expect-text (test-id "live") "1/1")
    (click (role button :name "Wait"))
    (expect-text (test-id "live") "1/1")
    (run-opportunity)
    (expect-text (test-id "nested") "Nested active")
    (click (role button :name "Toggle region"))
    (expect-absent (test-id "live"))
    (expect-absent (test-id "nested"))
    (click (role button :name "Increment"))
    (click (role button :name "Toggle region"))
    (expect-text (test-id "waiting") "Loading")
    (click (role button :name "Ready"))
    (run-opportunity)
    (expect-text (test-id "live") "2/0")))
