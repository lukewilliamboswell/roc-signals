(test "Supersede — a superseded subscription stops ticking"
  (steps
    (click (role button :name "Fast"))
    (expect-interval 100 1)
    (tick-interval 100)
    (expect-text (test-id "ticks") "1")
    (click (role button :name "Slow"))
    (expect-interval 100 0)
    (expect-interval 1000 1)
    (tick-interval-if-active 100)
    (expect-text (test-id "ticks") "1")
    (tick-interval 1000)
    (expect-text (test-id "ticks") "2")
    (click (role button :name "Pause"))
    (expect-interval 1000 0)
    (tick-interval-if-active 1000)
    (expect-text (test-id "ticks") "2")
  )
)
