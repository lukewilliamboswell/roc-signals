(test "Supersede — a resource in a component follows its prop and settles locally"
  (steps
    (click (role button :name "Open panel"))
    (expect-text (test-id "panel") "loading 1; showing none; before none")
    (stub-http "one" :url "/item/1" :status 200 :body "first")
    (mark-metrics)
    (run-effect 1)
    (expect-text (test-id "panel") "ready; showing 1:first; before none")
    (expect-metric-delta dirty_source_roots 1)
    (expect-metric-delta set_text 1)
    (click (role button :name "Pick 2"))
    (expect-text (test-id "panel") "loading 2; showing 1:first; before none")
    (expect-pending-effects 2)
    (stub-http "two" :url "/item/2" :status 200 :body "second")
    (run-effect 3)
    (expect-text (test-id "panel") "ready; showing 2:second; before 1:first")
  )
)
