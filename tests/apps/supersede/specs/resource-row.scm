(test "Supersede — a resource in each row settles its own row"
  (steps
    (click (role button :name "Load rows"))
    (expect-text (test-id "row a") "loading a/0")
    (expect-text (test-id "row b") "loading b/0")
    (expect-pending-effects 2)
    (stub-http "b0" :url "/row/b/0" :status 200 :body "bee")
    (mark-metrics)
    (run-effect 2)
    (expect-text (test-id "row b") "b/0:bee")
    (expect-text (test-id "row a") "loading a/0")
    (expect-metric-delta dirty_source_roots 1)
    (expect-metric-delta set_text 1)
    (expect-metric-delta patches_emitted 1)
    (click (role button :name "Reload a"))
    ; Reloading through the row's state supersedes the row's first request.
    (expect-text (test-id "row a") "loading a/1")
    (expect-pending-effects 1)
    (stub-http "a1" :url "/row/a/1" :status 200 :body "ay")
    (run-effect 3)
    (expect-text (test-id "row a") "a/1:ay")
    (expect-text (test-id "row b") "b/0:bee")
  )
)
