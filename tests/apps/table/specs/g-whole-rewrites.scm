(test "Table — a whole rewrite rebuilds every view of the table, and the next row edit is absorbed"
  (steps
    ; Every row toggled: a whole rewrite. Each list rebuilds (1,000
    ; placements each); every row of both windows is another row now (30
    ; rows of 14 holes, 5 of 1).
    (mark-metrics)
    (click (role button :name "Toggle all"))
    (expect-metric-delta derived_calls_into_roc 2427)
    (expect-metric-delta rows_updated 0)
    (expect-metric-delta patches_emitted 370)
    (expect-metric-delta set_text 0)
    (expect-metric-delta set_value 30)
    (expect-metric-delta set_checked 30)
    (expect-metric-delta rows_created 35)
    (expect-metric-delta rows_removed 35)
    (expect-metric-delta rows_moved 0)
    (expect-text (test-id "main") "679:1:0 37:3:0 395:5:0 753:7:0 111:9:0 469:11:0 827:13:0 185:15:0 543:17:0 901:19:0 259:21:0 617:23:0 975:25:0 333:27:0 691:29:0 49:31:0 407:33:0 765:35:0 123:37:0 481:39:0 839:41:0 197:43:0 555:45:0 913:47:0 271:49:0 629:51:0 987:53:0 345:55:0 703:57:0 61:59:0 ")
    (expect-text (test-id "done") "0=Task 0 2=Task 2 4=Task 4 6=Task 6 8=Task 8 ")
    ; The table replaced by a new one (`Table.from_list`), which the cell
    ; takes as a whole rewrite.
    (mark-metrics)
    (click (role button :name "Reset"))
    (expect-metric-delta derived_calls_into_roc 2427)
    (expect-metric-delta rows_updated 0)
    (expect-metric-delta patches_emitted 370)
    (expect-metric-delta set_text 0)
    (expect-metric-delta set_value 30)
    (expect-metric-delta set_checked 30)
    (expect-metric-delta rows_created 35)
    (expect-metric-delta rows_removed 35)
    (expect-metric-delta rows_moved 0)
    (expect-text (test-id "main") "0:0:0 358:2:0 716:4:0 74:6:0 432:8:0 790:10:0 148:12:0 506:14:0 864:16:0 222:18:0 580:20:0 938:22:0 296:24:0 654:26:0 12:28:0 370:30:0 728:32:0 86:34:0 444:36:0 802:38:0 160:40:0 518:42:0 876:44:0 234:46:0 592:48:0 950:50:0 308:52:0 666:54:0 24:56:0 382:58:0 ")
    (expect-text (test-id "done") "1=Task 1 3=Task 3 5=Task 5 7=Task 7 9=Task 9 ")
    ; The same again: every row is the row it was, so the windows keep
    ; their rows, whose holes are re-evaluated (90 and 5) and pruned.
    (mark-metrics)
    (click (role button :name "Reset"))
    (expect-metric-delta derived_calls_into_roc 2097)
    (expect-metric-delta rows_updated 35)
    (expect-metric-delta patches_emitted 0)
    (expect-metric-delta set_text 0)
    (expect-metric-delta set_value 0)
    (expect-metric-delta set_checked 0)
    (expect-metric-delta rows_created 0)
    (expect-metric-delta rows_removed 0)
    (expect-metric-delta rows_moved 0)
    ; A row edit after the rewrites is absorbed again.
    (mark-metrics)
    (click (label "Later 0"))
    (expect-metric-delta derived_calls_into_roc 9)
    (expect-metric-delta rows_updated 1)
    (expect-metric-delta patches_emitted 2)
    (expect-metric-delta set_text 1)
    (expect-metric-delta set_value 0)
    (expect-metric-delta set_checked 0)
    (expect-metric-delta rows_created 0)
    (expect-metric-delta rows_removed 0)
    (expect-metric-delta rows_moved 1)
    (expect-text (test-id "main") "358:2:0 716:4:0 74:6:0 432:8:0 790:10:0 148:12:0 506:14:0 864:16:0 222:18:0 580:20:0 938:22:0 296:24:0 0:25:0 654:26:0 12:28:0 370:30:0 728:32:0 86:34:0 444:36:0 802:38:0 160:40:0 518:42:0 876:44:0 234:46:0 592:48:0 950:50:0 308:52:0 666:54:0 24:56:0 382:58:0 ")
  )
)
