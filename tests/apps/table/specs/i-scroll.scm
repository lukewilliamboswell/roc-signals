(test "Table — scrolling by a row or by a page removes and creates the rows that leave and enter"
  (steps
    ; The window moved down one row: the window is read, the first row is
    ; removed and the 31st created. The ordered keys are not touched and
    ; no row is placed.
    (mark-metrics)
    (click (role button :name "Down 1"))
    (expect-metric-delta derived_calls_into_roc 15)
    (expect-metric-delta patches_emitted 12)
    (expect-metric-delta set_text 0)
    (expect-metric-delta set_value 1)
    (expect-metric-delta set_checked 1)
    (expect-metric-delta rows_created 1)
    (expect-metric-delta rows_removed 1)
    (expect-metric-delta rows_moved 0)
    (expect-text (test-id "main") "358:2:0 716:4:0 74:6:0 432:8:0 790:10:0 148:12:0 506:14:0 864:16:0 222:18:0 580:20:0 938:22:0 296:24:0 654:26:0 12:28:0 370:30:0 728:32:0 86:34:0 444:36:0 802:38:0 160:40:0 518:42:0 876:44:0 234:46:0 592:48:0 950:50:0 308:52:0 666:54:0 24:56:0 382:58:0 740:60:0 ")
    ; Down a page: 30 rows removed and 30 created.
    (mark-metrics)
    (click (role button :name "Down page"))
    (expect-metric-delta derived_calls_into_roc 421)
    (expect-metric-delta patches_emitted 360)
    (expect-metric-delta set_text 0)
    (expect-metric-delta set_value 30)
    (expect-metric-delta set_checked 30)
    (expect-metric-delta rows_created 30)
    (expect-metric-delta rows_removed 30)
    (expect-metric-delta rows_moved 0)
    (expect-text (test-id "main") "98:62:0 456:64:0 814:66:0 172:68:0 530:70:0 888:72:0 246:74:0 604:76:0 962:78:0 320:80:0 678:82:0 36:84:0 394:86:0 752:88:0 110:90:0 468:92:0 826:94:0 184:96:0 542:98:0 900:100:0 258:102:0 616:104:0 974:106:0 332:108:0 690:110:0 48:112:0 406:114:0 764:116:0 122:118:0 480:120:0 ")
    ; A row edit in the scrolled window.
    (mark-metrics)
    (click (label "Later 98"))
    (expect-metric-delta derived_calls_into_roc 9)
    (expect-metric-delta patches_emitted 2)
    (expect-metric-delta set_text 1)
    (expect-metric-delta set_value 0)
    (expect-metric-delta set_checked 0)
    (expect-metric-delta rows_created 0)
    (expect-metric-delta rows_removed 0)
    (expect-metric-delta rows_moved 1)
    (expect-text (test-id "main") "456:64:0 814:66:0 172:68:0 530:70:0 888:72:0 246:74:0 604:76:0 962:78:0 320:80:0 678:82:0 36:84:0 394:86:0 98:87:0 752:88:0 110:90:0 468:92:0 826:94:0 184:96:0 542:98:0 900:100:0 258:102:0 616:104:0 974:106:0 332:108:0 690:110:0 48:112:0 406:114:0 764:116:0 122:118:0 480:120:0 ")
    (mark-metrics)
    (click (role button :name "Up 1"))
    (expect-metric-delta derived_calls_into_roc 15)
    (expect-metric-delta patches_emitted 12)
    (expect-metric-delta set_text 0)
    (expect-metric-delta set_value 1)
    (expect-metric-delta set_checked 1)
    (expect-metric-delta rows_created 1)
    (expect-metric-delta rows_removed 1)
    (expect-metric-delta rows_moved 0)
    (expect-text (test-id "main") "740:60:0 456:64:0 814:66:0 172:68:0 530:70:0 888:72:0 246:74:0 604:76:0 962:78:0 320:80:0 678:82:0 36:84:0 394:86:0 98:87:0 752:88:0 110:90:0 468:92:0 826:94:0 184:96:0 542:98:0 900:100:0 258:102:0 616:104:0 974:106:0 332:108:0 690:110:0 48:112:0 406:114:0 764:116:0 122:118:0 ")
    (mark-metrics)
    (click (role button :name "Up page"))
    (expect-metric-delta derived_calls_into_roc 421)
    (expect-metric-delta patches_emitted 360)
    (expect-metric-delta set_text 0)
    (expect-metric-delta set_value 30)
    (expect-metric-delta set_checked 30)
    (expect-metric-delta rows_created 30)
    (expect-metric-delta rows_removed 30)
    (expect-metric-delta rows_moved 0)
    (expect-text (test-id "main") "0:0:0 358:2:0 716:4:0 74:6:0 432:8:0 790:10:0 148:12:0 506:14:0 864:16:0 222:18:0 580:20:0 938:22:0 296:24:0 654:26:0 12:28:0 370:30:0 728:32:0 86:34:0 444:36:0 802:38:0 160:40:0 518:42:0 876:44:0 234:46:0 592:48:0 950:50:0 308:52:0 666:54:0 24:56:0 382:58:0 ")
    ; At the top already: the window's value is equal, and nothing moves.
    (mark-metrics)
    (click (role button :name "Up 1"))
    (expect-metric-delta derived_calls_into_roc 1)
    (expect-metric-delta patches_emitted 0)
    (expect-metric-delta set_text 0)
    (expect-metric-delta set_value 0)
    (expect-metric-delta set_checked 0)
    (expect-metric-delta rows_created 0)
    (expect-metric-delta rows_removed 0)
    (expect-metric-delta rows_moved 0)
  )
)
