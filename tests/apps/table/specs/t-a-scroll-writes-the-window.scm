(test "scrolling writes a fixed-height window without moving the scrollbar"
  (steps
    (click (role button :name "Show scrolled list"))
    (expect-observed 1)
    (expect-text (test-id "scrolled-status") "0:0:0")
    (scroll (label "Scrolled todos") 80 0)
    (expect-text (test-id "scrolled-status") "80:0:1")
    (expect-text (test-id "scrolled") "4=Task 4 5=Task 5 6=Task 6 7=Task 7 8=Task 8 ")
    (mark-metrics)
    (scroll (label "Scrolled todos") 80 0)
    (expect-text (test-id "scrolled-status") "80:0:1")
    (expect-metric-delta dirty_source_roots 0)
    (expect-metric-delta patches_emitted 0)
    (mark-metrics)
    (scroll (label "Scrolled todos") 100 0)
    (expect-text (test-id "scrolled") "5=Task 5 6=Task 6 7=Task 7 8=Task 8 9=Task 9 ")
    (expect-metric-delta rows_created 1)
    (expect-metric-delta rows_removed 1)
    (expect-metric-delta rows_moved 0)
    (click (role button :name "Hide scrolled list"))
    (expect-observed 0)))
