(test "Table — a snapshot built by chained Store writes replaces rows and keeps surviving scopes"
  (setup (initial-location "/?n=3"))
  (steps
    (expect-text (test-id "main") "0:0:0 2:1:0 ")
    (expect-text (label "Qty 0") "0")
    (click (label "Mark 2"))
    (click (label "Bump 0"))
    (mark-metrics)
    (click (role button :name "Load Store chain"))
    (expect-text (test-id "count") "Rows: 3")
    (expect-text (test-id "row0") "Row 0: gone")
    (expect-text (test-id "main") "3:-1:0 2:1:1 ")
    (expect-text (test-id "done") "1=Task 1 ")
    (expect-absent (label "Qty 0"))
    (expect-metric-delta rows_created 1)
    (expect-metric-delta rows_removed 1)
    (expect-metric-delta rows_updated 2)
    (expect-metric-delta rows_moved 0)
    (mark-metrics)
    (click (role button :name "Load Store chain"))
    (expect-text (test-id "main") "3:-1:0 2:1:1 ")
    (expect-metric-delta rows_created 0)
    (expect-metric-delta rows_removed 0)
    (expect-metric-delta rows_updated 3)
  ))
