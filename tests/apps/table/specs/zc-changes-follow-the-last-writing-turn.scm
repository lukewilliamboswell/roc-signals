(test "Table changes and inverse stay observable until the next writing turn"
  (setup (initial-location "/?n=3&draws=changes"))
  (steps
    (expect-text (test-id "changes") "Changed: 0")
    (expect-text (test-id "inverse") "Inverse: 0")
    (click (label "Bump 0"))
    (expect-text (test-id "changes") "Changed: 1")
    (expect-text (test-id "inverse") "Inverse: 1")
    (click (role button :name "Touch shadow"))
    (click (role button :name "Touch next"))
    (expect-text (test-id "next") "Next: 4")
    (expect-text (test-id "changes") "Changed: 1")
    (expect-text (test-id "inverse") "Inverse: 1")
    (click (role button :name "Write twice"))
    (expect-text (test-id "changes") "Changed: 2")
    (expect-text (test-id "inverse") "Inverse: 2")
    (expect-text (test-id "main") "0:2:0 2:2:0 ")
    (click (role button :name "Undo previous"))
    (expect-text (test-id "main") "0:1:0 2:1:0 ")
    (expect-text (test-id "changes") "Changed: 2")
    (click (role button :name "Undo previous"))
    (expect-text (test-id "main") "0:2:0 2:2:0 ")
    (click (role button :name "Keep table"))
    (expect-text (test-id "changes") "Changed: 0")
    (expect-text (test-id "inverse") "Inverse: 0")
    (click (role button :name "Write with also"))
    (expect-text (test-id "changes") "Changed: 2")
    (expect-text (test-id "main") "0:3:0 2:3:0 ")
    (click (role button :name "Reset with also"))
    (expect-text (test-id "changes") "Rewritten")
    (expect-text (test-id "inverse") "No inverse")
    (expect-text (test-id "main") "3:-1:0 ")
    (expect-text (test-id "next") "Next: 0")
    (click (role button :name "Add"))
    (expect-text (test-id "changes") "Changed: 1")
    (expect-text (test-id "inverse") "Inverse: 1")
    (expect-text (test-id "main") "3:-1:0 0:0:0 ")
  ))
