(test "checked destinations remove refused input and recover"
  (steps
    (expect-attr (test-id "checked") href "/valid")
    (fill (label "Destination") "javascript:alert(1)")
    (expect-no-attr (test-id "checked") href)
    (mark-metrics)
    (click (role button :name "Refuse again"))
    (expect-no-attr (test-id "checked") href)
    (expect-metric-delta patches_emitted 0)
    (fill (label "Destination") " HTTPS://example.test/path ")
    (expect-attr (test-id "checked") href " HTTPS://example.test/path ")
    (fill (label "Destination") "/valid")
    (click (role button :name "Remove destination"))
    (expect-no-attr (test-id "checked") href)
    (mark-metrics)
    (click (role button :name "Remove destination"))
    (expect-metric-delta patches_emitted 0)
    (click (role button :name "Restore destination"))
    (expect-attr (test-id "checked") href "/valid")))
