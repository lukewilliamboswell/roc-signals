(test "opaque HTML round trip prunes equals and preserves row lifetimes"
  (steps
    (expect-attr (test-id "opaque") aria-label "Imported")
    (mark-metrics)
    (click (role button :name "Equal HTML"))
    (expect-metric-delta patches_emitted 0)
    (mark-metrics)
    (click (role button :name "Replace HTML"))
    (expect-metric-delta patches_emitted 2)
    (mark-metrics)
    (click (role button :name "Empty HTML"))
    (expect-metric-delta patches_emitted 2)
    (mark-metrics)
    (click (role button :name "Reverse rows"))
    (expect-metric-delta rows_moved 2)
    (expect-metric-delta scopes_created 0)
    (click (role button :name "Reverse rows"))
    (click (role button :name "Toggle HTML"))
    (expect-absent (test-id "opaque"))
    (click (role button :name "Toggle HTML"))
    (expect-attr (test-id "opaque") aria-label "Imported")
    (click (role button :name "Equal HTML"))))
