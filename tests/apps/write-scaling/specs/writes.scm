(test "Keyed and small writes retain the ten-row window"
 (steps
 (click (role button :name "Fill 1000"))
 (expect-text (text "a long row name 7") "a long row name 7")
 (mark-metrics)
 (click (role button :name "Rename"))
 (expect-text (text "a long row name 7!") "a long row name 7!")
 (expect-metric-delta rows_created 0)
 (expect-metric-delta rows_removed 0)
 (expect-metric-delta rows_updated 1)
 (click (role button :name "Count"))
 (expect-text (text "Count 1") "Count 1")
 (click (role button :name "Fill 10000"))
 (expect-text (text "a long row name 7") "a long row name 7")
 (click (role button :name "Rename"))
 (expect-text (text "a long row name 7!") "a long row name 7!")
 (click (role button :name "Count"))
 (expect-text (text "Count 2") "Count 2"))
)