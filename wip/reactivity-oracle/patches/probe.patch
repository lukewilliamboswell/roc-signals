+
+## The probe of a harness (`Core.probe`, `Core.describe`): `Quiet` in every
+## instance a host runs, so a `probe_note` costs one test of this tag and never
+## allocates; `Recording` keeps the facts noted since it was last taken.
+## Nothing in the engine reads a fact back: the probe is written and never
+## decides anything.
+Probe : [Quiet, Recording(List(Core.Fact))]
+
+## Note one fact if a harness is recording. A fact is built from scalars the
+## call site already holds, so building it allocates nothing when no one is.
+probe_note : Tx, Core.Fact -> Tx
+probe_note = |{ cmds, next, free, routes, work, paths, site_free, observations, fx, probe }, fact| match probe {
+	Quiet => { cmds, next, free, routes, work, paths, site_free, observations, fx, probe: Quiet }
+	Recording(facts) => { cmds, next, free, routes, work, paths, site_free, observations, fx, probe: Recording(facts.append(fact)) }
+}
+
+is_waiting : [Settled, Waiting] -> Bool
+is_waiting = |waits| match waits {
+	Waiting => True
+	Settled => False
+}
