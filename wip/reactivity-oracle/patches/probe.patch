+## The probe's rules (`Core.probe_tree`, `Core.probe_take`), checked on what
+## the engine holds and did, not on what it emitted:
+## - no site waits once a step has ended, and the root holds no write;
+## - the reads a block tests a pass against, for each child, cover every
+##   mask held below that child that names something above it: the
+##   hypothesis under which a pass that skips a child skips no reader;
+## - within one turn no hole is evaluated twice by a pass or its walk.
+## A site the probe does not describe (`Opaque`) is taken at its parent's
+## word and nothing below it is checked.
+probe_check : S, Str -> S
+probe_check = |s, what| {
+	held = tree_rule(Core.probe_tree(s.eng))
+	if !held.is_empty() {
+		crash "${what}: ${held}"
+	}
+	(eng, facts) = Core.probe_take(s.eng)
+	did = once_rule(facts)
+	if !did.is_empty() {
+		crash "${what}: ${did}"
+	}
+	{ ..s, eng }
+}
+
+## One open child while the tree's facts are read: what is read below it so
+## far, the layer bit its own site adds (never needed above it), the reads
+## its parent holds for it, and whether its site is one the probe describes.
+Frame : { need : U128, own_layer : U128, reads : U128, index : U64, seen : Bool }
+
+tree_rule : List(Core.Fact) -> Str
+tree_rule = |facts| {
+	var $stack = [{ need: 0, own_layer: 0, reads: 0xFFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF, index: 0, seen: Bool.True }]
+	var $sites = 0.U64
+	for fact in facts {
+		top : Frame
+		top = $stack.last() ?? crash "structure: the probe closed more children than it opened"
+		rest = $stack.drop_last(1)
+		match fact {
+			ChildAt({ index, reads }) => {
+				$stack = $stack.append({ need: 0, own_layer: 0, reads, index, seen: Bool.True })
+			}
+			AtSite({ kind, depth, waiting, own, cap: _ }) => {
+				$sites = $sites + 1
+				if waiting {
+					return "the probe found a site still waiting after the turn (site ${$sites.to_str()} in document order, depth ${depth.to_str()})"
+				}
+				own_layer = match kind {
+					State | Derive => if (depth < 64) (1.U128).shl_wrap(depth.to_u8_wrap()) else 0
+					_ => 0
+				}
+				seen = match kind {
+					Opaque => Bool.False
+					_ => Bool.True
+				}
+				$stack = rest.append({ need: top.need.bitwise_or(own), own_layer, reads: top.reads, index: top.index, seen })
+			}
+			HoleHeld({ node: _, mask, dirty: _ }) => {
+				$stack = rest.append({ ..top, need: top.need.bitwise_or(mask) })
+			}
+			Close => {
+				above = top.need - top.need.bitwise_and(top.own_layer)
+				if top.seen and above.bitwise_and(top.reads) != above {
+					return "the probe found child ${top.index.to_str()} of a block held with reads ${top.reads.to_str()} while something below it reads ${above.to_str()}"
+				}
+				parent : Frame
+				parent = rest.last() ?? crash "structure: the probe closed the root"
+				passed = if (top.seen) above else top.reads
+				$stack = rest.drop_last(1).append({ ..parent, need: parent.need.bitwise_or(passed) })
+			}
+			_ => {}
+		}
+	}
+	if ($stack.len() == 1) "" else "the probe left ${($stack.len() - 1).to_str()} children open"
+}
+
+## No hole is evaluated twice in one turn. A hole is named by its node and
+## its place in its block; the engine notes each evaluation where it makes
+## it (`refresh`), and a turn begins at each `TurnBegan`.
+once_rule : List(Core.Fact) -> Str
+once_rule = |facts| {
+	var $seen = []
+	var $turn = 0.U64
+	for fact in facts {
+		match fact {
+			TurnBegan => {
+				$seen = []
+				$turn = $turn + 1
+			}
+			Evaluated({ node: at, hole, carried: _, kept: _ }) => {
+				if $seen.contains((at, hole)) {
+					return "the probe found hole ${hole.to_str()} of node ${at.to_str()} evaluated twice in turn ${$turn.to_str()} of the step"
+				}
+				$seen = $seen.append((at, hole))
+			}
+			_ => {}
+		}
+	}
+	""
+}
