+## A block's answer to `Describe`: its holes as they are stored, then each
+## child with the reads its parent tests a pass against, in child order.
+describe_block : Block(ctx), ctx, Tx -> Tx
+describe_block = |{ holes, handlers: _, children, child_reads, child_top: _, nodes: _, tops: _, reads }, env, tx| {
+	var $tx = probe_note(tx, BlockReads(reads))
+	for hole in holes {
+		$tx = probe_note($tx, HoleHeld({ node: hole.node, mask: hole.mask, dirty: hole.dirty }))
+	}
+	var $ks = children
+	var $j = 0.U64
+	while $j < $ks.len() {
+		{ list, prev } = $ks.replace($j, noop({})) ?? crash "child"
+		(_, _, t1) = call(prev, env, Describe, probe_note($tx, ChildAt({ index: $j, reads: child_reads.get($j) ?? 0 })))
+		$tx = probe_note(t1, Close)
+		$ks = list
+		$j = $j + 1
+	}
+	$tx
 }
 
