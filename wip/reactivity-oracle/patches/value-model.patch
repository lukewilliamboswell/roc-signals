+## Mode 5: a seeded series of generated trees and sessions in valued mode.
+valued_series : U64, U64 -> Tally
+valued_series = |seed, count| {
+	var $x = seed
+	var $k = 0.U64
+	var $tally = no_tally
+	while $k < count {
+		var $bytes = []
+		var $j = 0.U64
+		while $j < 160 {
+			$x = SpecRunner.prng($x)
+			$bytes = $bytes.append($x.shr_zf_wrap(40).to_u8_wrap())
+			$j = $j + 1
+		}
+		t = run_valued(decode($bytes.take_first(80)), $bytes.drop_first(80))
+		$tally = { steps: $tally.steps + t.steps, doubles: $tally.doubles + t.doubles, marked: $tally.marked + t.marked, lost: $tally.lost + t.lost, evals: $tally.evals + t.evals }
+		$k = $k + 1
+	}
+	$tally
+}
