+# ---------------------------------------------------------- the value model
+
+# Mode 4 (valued): every state is written by clicks and nothing is awaited,
+# so the page is a function of the tree and of the local states that are
+# alive. `page` is that function, written from the generator's description
+# of each node and from nothing in the engine: no `Core`, no `Dom`.
+
+## Where the generator's typed levels put a body: the level a layer's body
+## and a row's body are built at, or `Err(InPlace)` past the last level,
+## where a `Layer` and an `Each` add no scope.
+Level : [Root, Second, Third, Last, InRow, Flat]
+
+level_below : Level -> Try({ layer : Level, row : Level }, [InPlace])
+level_below = |level| match level {
+	Root => Ok({ layer: Second, row: InRow })
+	Second => Ok({ layer: Third, row: InRow })
+	Third => Ok({ layer: Last, row: InRow })
+	Last => Ok({ layer: Flat, row: Flat })
+	InRow => Ok({ layer: Last, row: Flat })
+	Flat => Err(InPlace)
+}
+
+## What the model draws, in document order: a text, a button with its
+## label and the states a click writes (by identity, in the handler's
+## order), and a state that is alive (it draws nothing itself).
+Leaf : [Text(Str), Button(Str, List(Str)), Live(Str)]
+
+## The values a node can read and the states it can write where it is
+## built, as the generator's `G` holds signals and states.
+Scope : { vals : List(U64), wrs : List(Str) }
+
+## Local state by structural identity: the path of child positions,
+## branches taken and row keys from the root to a state's site. A state
+## not held is at its initial value, 0.
+Held : List((Str, U64))
+
+held_value : Held, Str -> U64
+held_value = |held, at| match held.find_first(|(name, _)| name == at) {
+	Ok((_, value)) => value
+	Err(_) => 0
+}
+
+seen : Scope, U64 -> U64
+seen = |scope, i| pick(scope.vals, i, 0)
+
+## What a structural reader follows (`chosen_of`).
+chosen : Scope, U64 -> U64
+chosen = |scope, i| if (i >= 128) seen(scope, i) + seen(scope, i // 16) else seen(scope, i)
+
+wrote : Scope, U64 -> Str
+wrote = |scope, i| pick(scope.wrs, i, "")
+
+drawn_list : List(Node), Scope, Level, Str, Held -> List(Leaf)
+drawn_list = |ns, scope, level, at, held| {
+	var $out = []
+	var $k = 0.U64
+	for n in ns {
+		$out = $out.concat(drawn(n, scope, level, "${at}/${$k.to_str()}", held))
+		$k = $k + 1
+	}
+	$out
+}
+
+drawn : Node, Scope, Level, Str, Held -> List(Leaf)
+drawn = |n, scope, level, at, held| match n {
+	Show(i) => [Text(seen(scope, i).to_str())]
+	Guard(_) | Control(_) | Watch(_, _) => []
+	Bump(i) => [Button("+", [wrote(scope, i)])]
+	Bump2(i, j) => [Button("++", [wrote(scope, i), wrote(scope, j)])]
+	Pair(i, j) => {
+		x = seen(scope, i)
+		[Text("${pair_mark}${x.to_str()}~${(x * 2 + 1).to_str()}~${seen(scope, j).to_str()}")]
+	}
+	When(i, yes, no) => if (chosen(scope, i) % 2 == 0) drawn_list(yes, scope, level, "${at}y", held) else drawn_list(no, scope, level, "${at}n", held)
+	Switch(i, a, b, c) => {
+		k = chosen(scope, i) % 3
+		drawn_list(if (k == 0) a else if (k == 1) b else c, scope, level, "${at}s${k.to_str()}", held)
+	}
+	Layer(kind, i, body) => match level_below(level) {
+		Err(_) => drawn_list(body, scope, level, at, held)
+		Ok(below) =>
+			if kind % 5 == 0 {
+				value = held_value(held, at)
+				[Live(at), Text(value.to_str()), Button("+", [at])].concat(drawn_list(body, { vals: scope.vals.append(value), wrs: scope.wrs.append(at) }, below.layer, at, held))
+			} else {
+				value = if (kind % 5 == 1) seen(scope, i) * 2 + 1 else seen(scope, i) + 7
+				[Text(value.to_str())].concat(drawn_list(body, { vals: scope.vals.append(value), wrs: scope.wrs }, below.layer, at, held))
+			}
+	}
+	Each(i, body) => match level_below(level) {
+		Err(_) => drawn_list(body, scope, level, at, held)
+		Ok(below) => row_keys(chosen(scope, i)).fold([], |acc, key| acc.append(Text(key.to_str())).concat(drawn_list(body, { vals: scope.vals.append(key), wrs: scope.wrs }, below.row, "${at}k${key.to_str()}", held)))
+	}
+}
+
+## The page from scratch: the root state, its button, then the tree.
+page : List(Node), Held -> List(Leaf)
+page = |tree, held| {
+	root = held_value(held, "")
+	[Live(""), Text(root.to_str()), Button("+", [""])].concat(drawn_list(tree, { vals: [root], wrs: [""] }, Root, "", held))
+}
+
+## One click on the `k`-th button in document order: every write of the
+## handler is applied, each adding 1; then a state is kept if and only if
+## the page drawn from the result still holds it.
+clicked : List(Node), Held, U64 -> Held
+clicked = |tree, held, k| {
+	written = writes_at(tree, held, k).fold(held, |acc, at| acc.keep_if(|(name, _)| name != at).append((at, held_value(acc, at) + 1)))
+	alive = page(tree, written).fold(
+		[],
+		|acc, leaf| match leaf {
+			Live(at) => acc.append(at)
+			_ => acc
+		},
+	)
+	written.keep_if(|(name, _)| alive.contains(name))
+}
+
+## The states the `k`-th button in document order writes, in its handler's order.
+writes_at : List(Node), Held, U64 -> List(Str)
+writes_at = |tree, held, k| {
+	buttons = page(tree, held).fold(
+		[],
+		|acc, leaf| match leaf {
+			Button(_, writes) => acc.append(writes)
+			_ => acc
+		},
+	)
+	buttons.get(k) ?? []
+}
+
+## What a page shows of the model's leaves: each text, and each button's label.
+texts_of : List(Leaf) -> List(Str)
+texts_of = |leaves| leaves.fold(
+	[],
+	|acc, leaf| match leaf {
+		Text(text) => acc.append(text)
+		Button(label, _) => acc.append(label)
+		Live(_) => acc
+	},
+)
+
+buttons_in : List(Leaf) -> U64
+buttons_in = |leaves| leaves.fold(
+	0,
+	|acc, leaf| match leaf {
+		Button(_, _) => acc + 1
+		_ => acc
+	},
+)
+
+## The same projection of the oracle's DOM: every text node that is not
+## empty, in document order. Wrapper elements, attributes and properties
+## are left out, so the comparison does not depend on how `flat` nests
+## its `div`s.
+page_texts : Dom.Model, U64 -> List(Str)
+page_texts = |dom, index| {
+	entry = Dom.node(dom, index)
+	if entry.kind == 2 {
+		if (entry.text.is_empty()) [] else [entry.text]
+	} else if entry.kind == 3 {
+		[]
+	} else {
+		entry.kids.fold([], |acc, kid| acc.concat(page_texts(dom, kid)))
+	}
+}
+
+## The page the engine drew must be the page the model draws from scratch,
+## and offer the same buttons.
+agree : S, List(Node), Held, Str -> {}
+agree = |s, tree, held, what| {
+	want = page(tree, held)
+	got = page_texts(s.dom, s.dom.root)
+	if got != texts_of(want) {
+		crash "${what}: the page differs from the value model:\n  engine ${Str.inspect(got)}\n  model  ${Str.inspect(texts_of(want))}\n  states ${Str.inspect(held)}"
+	}
+	if click_candidates(s.dom).len() != buttons_in(want) {
+		crash "${what}: the page offers ${click_candidates(s.dom).len().to_str()} buttons, the value model ${buttons_in(want).to_str()}"
+	}
+	{}
+}
+
+## What a valued session exercised, so a passing series can be shown not
+## to be vacuous: clicks; clicks that wrote two different states; clicks
+## after which some state below the root is not at its initial value; and
+## states below the root, not at their initial value, that a click's turn
+## disposed.
+Tally : { steps : U64, doubles : U64, marked : U64, lost : U64, evals : U64 }
+
+no_tally : Tally
+no_tally = { steps: 0, doubles: 0, marked: 0, lost: 0, evals: 0 }
+
+## Mode 4: a session of clicks, each compared with the value model.
+run_valued : List(Node), List(U8) -> Tally
+run_valued = |tree, events| {
+	var $s = settle_check(mount_as(tree, False, True, 0), "mount")
+	var $held = []
+	var $tally = no_tally
+	agree($s, tree, $held, "mount")
+	var $i = 0.U64
+	while $i + 1 < events.len() {
+		b = (events.get($i + 1) ?? 0).to_u64()
+		k = b % buttons_in(page(tree, $held)).max(1)
+		(s1, what0) = step($s, 0, b)
+		what = "valued step ${($i // 2).to_str()} (${what0}, button ${k.to_str()})"
+		before = $held
+		evals = Core.evals(s1.eng) - Core.evals($s.eng)
+		$s = settle_check(s1, what)
+		$held = clicked(tree, before, k)
+		agree($s, tree, $held, what)
+		after = $held
+		writes = writes_at(tree, before, k)
+		$tally = {
+			steps: $tally.steps + 1,
+			doubles: $tally.doubles + (if (writes.len() == 2 and writes.get(0) != writes.get(1)) 1 else 0),
+			marked: $tally.marked + (if (after.any(|(name, value)| name != "" and value > 0)) 1 else 0),
+			lost: $tally.lost + before.keep_if(|(name, value)| name != "" and value > 0 and !after.any(|(kept, _)| kept == name)).len(),
+			evals: $tally.evals + evals,
+		}
+		$i = $i + 2
+	}
+	$tally
+}
+
