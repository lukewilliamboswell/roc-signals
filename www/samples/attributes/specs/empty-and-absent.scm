(test "Empty attributes and option values remain distinct from absence"
  (steps
    (expect-value (label "Works") "")
    (expect-text (test-id "selection") "All works")
    (expect-attr (test-id "decoration") "alt" "")
    (expect-no-attr (test-id "note") "data-note")
    (select-option (label "Works") "a")
    (expect-value (label "Works") "a")
    (expect-text (test-id "selection") "Work A")
    (select-option (label "Works") "")
    (expect-value (label "Works") "")
    (expect-text (test-id "selection") "All works")
    (mark-metrics)
    (click (role button :name "Toggle note"))
    (expect-attr (test-id "note") "data-note" "")
    (expect-metric-delta patches_emitted 1)
    (mark-metrics)
    (click (role button :name "Toggle note"))
    (expect-no-attr (test-id "note") "data-note")
    (expect-metric-delta patches_emitted 1)))
