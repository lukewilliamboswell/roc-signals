(test "Primes — each shard shows as it answers, the total follows the last, and a new split keeps the total while it works"
  (steps
    (expect-pending-effects 2)
    (expect-text (test-id "total") "Counting…")
    (run-effect 2)
    (expect-text (test-id "shards") "… 135")
    (run-effect 1)
    (expect-text (test-id "shards") "168 135")
    (expect-text (test-id "total") "303 primes")
    (fill (label "Shards") "4")
    (expect-pending-effects 4)
    (expect-text (test-id "total") "303 (counting…)")
    (run-effect 3)
    (run-effect 4)
    (run-effect 5)
    (expect-text (test-id "shards") "95 73 71 …")
    (run-effect 6)
    (expect-text (test-id "total") "303 primes")
  )
)
