(test "The app reconnects after a lost feed and resumes the last kept sequence"
  (setup (seed 7))
  (steps
    (click (role button :name "Connect event stream"))
    (expect-port-subscriptions "example.org/recipes/sse" 1)
    (expect-port-subscription-arg "example.org/recipes/sse" 1 "{\"after\":\"0\",\"url\":\"/events\"}")
    (emit-port "example.org/recipes/sse" "\"Opened\"")
    (expect-text (test-id "socket-result") "Connection opened; waiting for data")
    (emit-port "example.org/recipes/sse" "{\"Event\":{\"data\":\"ready\",\"dropped\":\"0\",\"seq\":\"9\"}}")
    (expect-text (test-id "socket-result") "ready (gap 8, dropped 0)")
    (fail-port "example.org/recipes/sse" "lost")
    (expect-port-subscriptions "example.org/recipes/sse" 0)
    (run-effect 1)
    (expect-port-subscriptions "example.org/recipes/sse" 1)
    (expect-port-subscription-arg "example.org/recipes/sse" 1 "{\"after\":\"9\",\"url\":\"/events\"}")
    (click (role button :name "Pause connection"))
    (expect-port-subscriptions "example.org/recipes/sse" 0)
    (click (role button :name "Connect WebSocket"))
    (expect-port-subscriptions "example.org/recipes/websocket" 1)
    (click (role button :name "Send greeting"))
    (expect-port-sent "example.org/recipes/socket-send" 1 "{\"connection\":\"primary\",\"data\":\"hello\"}")
    (close-port "example.org/recipes/websocket")
    (expect-port-subscriptions "example.org/recipes/websocket" 0)
    (click (role button :name "Pause connection"))
    (expect-pending-effects 0)))
